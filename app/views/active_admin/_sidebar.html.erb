<%# MotoGate Admin Sidebar — mirrors includes/sidebar.php in the PHP demo %>
<% cp = request.path %>

<aside class="admin-sidebar" id="admin-sidebar">

  <%# ===== Brand ===== %>
  <div class="sidebar-brand">
    <img src="/admin_logo.png" alt="MotoGate" class="sidebar-logo" onerror="this.style.display='none'">
    <span class="sidebar-title">MotoGate</span>
  </div>

  <%# ===== Navigation ===== %>
  <nav class="sidebar-nav">

  <% if current_admin_user.partner? %>
    <%# Partner accounts only ever get access to their own bookings and
       their own center's profile (enforced server-side by
       PartnerAccessControl) — the sidebar should only offer those two,
       not a full menu of links that would just bounce them back. %>
    <p class="menu-header">ເມນູຫຼັກ</p>

    <%= link_to admin_dashboard_path,
        class: "sidebar-link #{'active' if cp == '/admin' || cp.start_with?('/admin/dashboard')}" do %>
      <i class="fas fa-home"></i><span>Dashboard</span>
    <% end %>

    <%= link_to admin_inspections_path,
        class: "sidebar-link #{'active' if cp.start_with?('/admin/inspections')}" do %>
      <i class="fas fa-car"></i><span>ລົດທີ່ຈະເຂົ້າມາກວດ</span>
    <% end %>

    <%= link_to admin_inspection_center_path(current_admin_user.inspection_center),
        class: "sidebar-link #{'active' if cp.start_with?('/admin/inspection_centers')}" do %>
      <i class="fas fa-warehouse"></i><span>ສູນກວດກາເຕັກນິກ</span>
    <% end %>

    <%= link_to admin_reports_path,
        class: "sidebar-link #{'active' if cp.start_with?('/admin/reports')}" do %>
      <i class="fas fa-chart-bar"></i><span>ລາຍງານ</span>
    <% end %>
  <% elsif current_admin_user.insurance? %>
    <%# Insurance-company accounts only ever get access to their own
       orders, their own company profile, dashboard and reports
       (enforced server-side by InsuranceAccessControl) — mirrors the
       partner branch above. %>
    <p class="menu-header">ເມນູຫຼັກ</p>

    <%= link_to admin_dashboard_path,
        class: "sidebar-link #{'active' if cp == '/admin' || cp.start_with?('/admin/dashboard')}" do %>
      <i class="fas fa-home"></i><span>Dashboard</span>
    <% end %>

    <%= link_to admin_insurance_company_path(current_admin_user.insurance_company),
        class: "sidebar-link #{'active' if cp.start_with?('/admin/insurance_companies')}" do %>
      <i class="fas fa-building-shield"></i><span>ບໍລິສັດປະກັນໄພ</span>
    <% end %>

    <%= link_to admin_reports_path,
        class: "sidebar-link #{'active' if cp.start_with?('/admin/reports')}" do %>
      <i class="fas fa-chart-bar"></i><span>ລາຍງານ</span>
    <% end %>
  <% elsif current_admin_user.service_partner? %>
    <%# service_partner accounts (garage/dealer/towing owners) only ever
       get access to their own center's overview, profile, contract and
       revenue report (enforced server-side by ServicePartnerAccessControl)
       — mirrors the insurance branch above. %>
    <% sc = current_admin_user.service_center %>
    <p class="menu-header">ເມນູຫຼັກ</p>

    <%= link_to admin_service_center_overview_path(type: sc.service_type),
        class: "sidebar-link #{'active' if cp.start_with?('/admin/service_center_overviews') || cp == '/admin' || cp.start_with?('/admin/dashboard')}" do %>
      <i class="fas fa-chart-line"></i><span>ພາບລວມ</span>
    <% end %>

    <%= link_to admin_service_center_path(sc),
        class: "sidebar-link #{'active' if cp.start_with?('/admin/service_centers')}" do %>
      <i class="fas fa-id-card"></i><span>ໂປຣໄຟລ໌ຂອງຂ້ອຍ</span>
    <% end %>

    <%= link_to admin_service_center_contracts_path(q: { type: sc.service_type }),
        class: "sidebar-link #{'active' if cp.start_with?('/admin/service_center_contracts')}" do %>
      <i class="fas fa-file-contract"></i><span>ສັນຍາ & ຄ່າເຊົ່າ</span>
    <% end %>

    <%= link_to admin_service_center_revenue_reports_path(type: sc.service_type),
        class: "sidebar-link #{'active' if cp.start_with?('/admin/service_center_revenue_reports')}" do %>
      <i class="fas fa-chart-bar"></i><span>ລາຍງານລາຍຮັບ</span>
    <% end %>
  <% elsif current_admin_user.staff? %>
    <%# "Staff" accounts are built from a flexible Role → Permission matrix
       (see Role/Permission models) instead of a hardcoded scope, so the
       sidebar itself is generated from whichever resources their Role was
       granted :read on — enforced server-side by
       RolePermissionAccessControl, this just avoids offering links that
       would immediately bounce them back to the dashboard. %>
    <p class="menu-header">ເມນູຫຼັກ</p>

    <%= link_to admin_dashboard_path,
        class: "sidebar-link #{'active' if cp == '/admin' || cp.start_with?('/admin/dashboard')}" do %>
      <i class="fas fa-home"></i><span>Dashboard</span>
    <% end %>

    <% (current_admin_user.custom_role&.permissions&.where(can_read: true) || []).each do |perm| %>
      <% entry = Permission::CATALOG[perm.resource] %>
      <% next unless entry %>
      <%= link_to Permission.path_for(perm.resource),
          class: "sidebar-link #{'active' if cp.start_with?("/admin/#{perm.resource}")}" do %>
        <i class="fas <%= entry[:icon] %>"></i><span><%= entry[:label] %></span>
      <% end %>
    <% end %>
  <% else %>

    <%# ========== ເມນູຫຼັກ ========== %>
    <p class="menu-header">ເມນູຫຼັກ</p>

    <%= link_to admin_dashboard_path,
        class: "sidebar-link #{'active' if cp == '/admin' || cp.start_with?('/admin/dashboard')}" do %>
      <i class="fas fa-home"></i><span>Dashboard</span>
    <% end %>

    <%= link_to admin_users_path,
        class: "sidebar-link #{'active' if cp.start_with?('/admin/users')}" do %>
      <i class="fas fa-users"></i><span>ລູກຄ້າທັງໝົດ</span>
    <% end %>

    <%= link_to admin_vehicles_path,
        class: "sidebar-link #{'active' if cp.start_with?('/admin/vehicles')}" do %>
      <i class="fas fa-car"></i><span>ລາຍການພາຫານະ</span>
    <% end %>

    <%# Vehicle data dropdown %>
    <div class="sidebar-group">
      <button class="sidebar-link sidebar-group-btn" type="button">
        <i class="fas fa-car-side"></i><span>ຈັດການຂໍ້ມູນລົດ</span>
        <i class="fas fa-chevron-down sidebar-arrow"></i>
      </button>
      <div class="sidebar-submenu">
        <%= link_to admin_vehicle_brands_path, class: "submenu-link" do %>
          <i class="fas fa-trademark"></i>ຈັດການຍີ່ຫໍ້ລົດ
        <% end %>
        <%= link_to admin_vehicle_fee_reports_path, class: "submenu-link" do %>
          <i class="fas fa-receipt"></i>ລາຍງານຊຳລະຄ່າທຳນຽມ
        <% end %>
        <%= link_to admin_road_tax_rates_path, class: "submenu-link" do %>
          <i class="fas fa-cog"></i>ກຳນົດອັດຕາຄ່າທາງ
        <% end %>
        <%= link_to admin_vehicle_fee_rates_path, class: "submenu-link" do %>
          <i class="fas fa-coins"></i>ຄ່າທຳນຽມລົງທະບຽນລົດ
        <% end %>
      </div>
    </div>

    <a href="/admin" class="sidebar-link">
      <i class="fas fa-bell"></i><span>ແຈ້ງເຕືອນໝົດອາຍຸ</span>
    </a>

    <%# ========== ຈັດການ Product ========== %>
    <p class="menu-header">ຈັດການ Product</p>

    <%# Support System dropdown %>
    <div class="sidebar-group">
      <button class="sidebar-link sidebar-group-btn" type="button">
        <i class="fas fa-comments"></i><span>Support System</span>
        <i class="fas fa-chevron-down sidebar-arrow"></i>
      </button>
      <div class="sidebar-submenu">
        <%= link_to admin_support_dashboard_path, class: "submenu-link" do %>
          <i class="fas fa-chart-line"></i>Dashboard Support
        <% end %>
        <%= link_to admin_support_chat_path, class: "submenu-link" do %>
          <i class="fas fa-list"></i>Support List
          <% unread = ChatMessage.where(sender: "user", read_by_admin: false).count %>
          <% if unread > 0 %><span class="notification-badge"><%= unread %></span><% end %>
        <% end %>
        <%= link_to admin_support_chat_path(status: "open"), class: "submenu-link" do %>
          <i class="fas fa-clipboard-list"></i>Case Management
        <% end %>
        <%= link_to admin_support_templates_path, class: "submenu-link" do %>
          <i class="fas fa-file-alt"></i>Quick Templates
        <% end %>
        <%= link_to admin_support_chat_path(room: "next"), class: "submenu-link" do %>
          <i class="fas fa-door-open"></i>Support Room
        <% end %>
        <%= link_to admin_support_templates_path, class: "submenu-link" do %>
          <i class="fas fa-bolt"></i>Quick Replies
        <% end %>
        <%= link_to admin_support_agents_path, class: "submenu-link" do %>
          <i class="fas fa-user-tie"></i>Support Agents
        <% end %>
        <%= link_to admin_support_chat_path(status: "resolved"), class: "submenu-link" do %>
          <i class="fas fa-history"></i>Support Archives
        <% end %>
        <%= link_to admin_support_feedback_path, class: "submenu-link" do %>
          <i class="fas fa-comment-alt"></i>Feedback
        <% end %>
      </div>
    </div>

    <%# Vehicle Info Management dropdown %>
    <%= link_to admin_plate_types_path,
        class: "sidebar-link #{'active' if cp.start_with?('/admin/plate_types')}" do %>
      <i class="fas fa-id-card"></i><span>ຈັດການປ້າຍທະບຽນ</span>
    <% end %>

    <%# Insurance dropdown %>
    <% ins_open = cp.start_with?('/admin/insurances') || cp.start_with?('/admin/insurance_companies') %>
    <div class="sidebar-group <%= 'open' if ins_open %>">
      <button class="sidebar-link sidebar-group-btn <%= 'parent-active' if ins_open %>" type="button">
        <i class="fas fa-shield-alt"></i><span>ຈັດການປະກັນໄພ</span>
        <i class="fas fa-chevron-down sidebar-arrow"></i>
      </button>
      <div class="sidebar-submenu">
        <a href="/admin" class="submenu-link"><i class="fas fa-chart-line"></i>Dashboard Insurance</a>
        <%= link_to admin_insurance_companies_path,
            class: "submenu-link #{'active' if cp.start_with?('/admin/insurance_companies')}" do %>
          <i class="fas fa-building"></i>ບໍລິສັດປະກັນໄພ
        <% end %>
        <a href="/admin/reports" class="submenu-link"><i class="fas fa-file-invoice-dollar"></i>ລາຍງານການຂາຍ</a>
      </div>
    </div>

    <%# Inspection dropdown %>
    <% ins2_open = cp.start_with?('/admin/inspections') %>
    <div class="sidebar-group <%= 'open' if ins2_open %>">
      <button class="sidebar-link sidebar-group-btn <%= 'parent-active' if ins2_open %>" type="button">
        <i class="fas fa-tools"></i><span>ຈັດການສູນເຕັກນິກ</span>
        <i class="fas fa-chevron-down sidebar-arrow"></i>
      </button>
      <div class="sidebar-submenu">
        <a href="/admin" class="submenu-link"><i class="fas fa-chart-line"></i>Dashboard Inspection</a>
        <%= link_to admin_inspection_centers_path,
            class: "submenu-link #{'active' if cp.start_with?('/admin/inspection_centers')}" do %>
          <i class="fas fa-warehouse"></i>ສູນກວດກາເຕັກນິກ
        <% end %>
        <%= link_to admin_inspections_path,
            class: "submenu-link #{'active' if cp.start_with?('/admin/inspections')}" do %>
          <i class="fas fa-car"></i>ລົດທີ່ຈະເຂົ້າມາກວດ
        <% end %>
        <a href="/admin/reports" class="submenu-link"><i class="fas fa-clipboard-check"></i>ລາຍງານການກວດກາ</a>
      </div>
    </div>

    <%# Road Tax dropdown %>
    <% rt_open = cp.start_with?('/admin/road_taxes') || cp.start_with?('/admin/road_tax_rates') || cp.start_with?('/admin/road_tax_settings') %>
    <div class="sidebar-group <%= 'open' if rt_open %>">
      <button class="sidebar-link sidebar-group-btn <%= 'parent-active' if rt_open %>" type="button">
        <i class="fas fa-road"></i><span>ຈັດການເສຍຄ່າທາງ</span>
        <i class="fas fa-chevron-down sidebar-arrow"></i>
      </button>
      <div class="sidebar-submenu">
        <a href="/admin" class="submenu-link"><i class="fas fa-chart-line"></i>Dashboard Road Tax</a>
        <%= link_to admin_road_taxes_path,
            class: "submenu-link #{'active' if cp.start_with?('/admin/road_taxes')}" do %>
          <i class="fas fa-file-invoice-dollar"></i>ຈັດການຄ່າທາງ
        <% end %>
        <%= link_to admin_road_tax_rates_path,
            class: "submenu-link #{'active' if cp.start_with?('/admin/road_tax_rates')}" do %>
          <i class="fas fa-tags"></i>ອັດຕາຄ່າທາງ
        <% end %>
        <%= link_to edit_admin_road_tax_setting_path(RoadTaxSetting.current),
            class: "submenu-link #{'active' if cp.start_with?('/admin/road_tax_settings')}" do %>
          <i class="fas fa-sliders-h"></i>ຄ່າທຳນຽມແພລດຟອມ
        <% end %>
        <a href="/admin/reports" class="submenu-link"><i class="fas fa-chart-bar"></i>ລາຍງານເສຍຄ່າທາງ</a>
      </div>
    </div>

    <%# Garage (repair centers) dropdown %>
    <div class="sidebar-group">
      <button class="sidebar-link sidebar-group-btn" type="button">
        <i class="fas fa-store"></i><span>ຈັດການສູນສ້ອມແປງລົດ</span>
        <i class="fas fa-chevron-down sidebar-arrow"></i>
      </button>
      <div class="sidebar-submenu">
        <%= link_to admin_service_center_overview_path(type: "garage"), class: "submenu-link" do %>
          <i class="fas fa-chart-pie"></i>ພາບລວມສູນສ້ອມແປງ
        <% end %>
        <%= link_to admin_service_centers_path(q: { service_type_eq: "garage" }), class: "submenu-link" do %>
          <i class="fas fa-id-card"></i>ຈັດການໂປຣໄຟລ໌ພາດເນີ
        <% end %>
        <%= link_to admin_service_center_contracts_path(q: { type: "garage" }), class: "submenu-link" do %>
          <i class="fas fa-file-contract"></i>ສັນຍາ & ຄ່າເຊົ່າ
        <% end %>
        <%= link_to admin_service_center_revenue_reports_path(type: "garage"), class: "submenu-link" do %>
          <i class="fas fa-chart-line"></i>ລາຍງານລາຍຮັບຄ່າເຊົ່າ
        <% end %>
      </div>
    </div>

    <%# Dealer (dealership) dropdown %>
    <div class="sidebar-group">
      <button class="sidebar-link sidebar-group-btn" type="button">
        <i class="fas fa-car-side"></i><span>ຈັດການສູນຂາຍລົດ</span>
        <i class="fas fa-chevron-down sidebar-arrow"></i>
      </button>
      <div class="sidebar-submenu">
        <%= link_to admin_service_center_overview_path(type: "dealer"), class: "submenu-link" do %>
          <i class="fas fa-chart-pie"></i>ພາບລວມສູນຂາຍລົດ
        <% end %>
        <%= link_to admin_service_centers_path(q: { service_type_eq: "dealer" }), class: "submenu-link" do %>
          <i class="fas fa-id-card"></i>ໂປຣໄຟລ໌ໂຊຣູມພາດເນີ
        <% end %>
        <%= link_to admin_service_center_contracts_path(q: { type: "dealer" }), class: "submenu-link" do %>
          <i class="fas fa-file-contract"></i>ສັນຍາໂຄສະນາ/ຄ່າເຊົ່າ
        <% end %>
        <%= link_to admin_service_center_revenue_reports_path(type: "dealer"), class: "submenu-link" do %>
          <i class="fas fa-chart-line"></i>ລາຍງານລາຍຮັບຄ່າເຊົ່າ
        <% end %>
      </div>
    </div>

    <%# Towing dropdown %>
    <div class="sidebar-group">
      <button class="sidebar-link sidebar-group-btn" type="button">
        <i class="fas fa-truck-pickup"></i><span>ບໍລິການລາກລົດ 24ຊມ</span>
        <i class="fas fa-chevron-down sidebar-arrow"></i>
      </button>
      <div class="sidebar-submenu">
        <%= link_to admin_service_center_overview_path(type: "towing"), class: "submenu-link" do %>
          <i class="fas fa-chart-pie"></i>ພາບລວມການບໍລິການ
        <% end %>
        <%= link_to admin_service_centers_path(q: { service_type_eq: "towing" }), class: "submenu-link" do %>
          <i class="fas fa-id-card"></i>ຈັດການເບີຕິດຕໍ່/ໂປຣໄຟລ໌
        <% end %>
        <%= link_to admin_service_center_contracts_path(q: { type: "towing" }), class: "submenu-link" do %>
          <i class="fas fa-file-contract"></i>ສັນຍາພາດເນີລາກລົດ
        <% end %>
        <%= link_to admin_service_center_revenue_reports_path(type: "towing"), class: "submenu-link" do %>
          <i class="fas fa-chart-line"></i>ລາຍງານຄ່າເຊົ່າລະບົບ
        <% end %>
      </div>
    </div>

    <%# ========== ລາຍງານ ========== %>
    <p class="menu-header">ລາຍງານ</p>

    <% rpt_open = cp.start_with?('/admin/reports') || cp.start_with?('/admin/transactions') %>
    <div class="sidebar-group <%= 'open' if rpt_open %>">
      <button class="sidebar-link sidebar-group-btn <%= 'parent-active' if rpt_open %>" type="button">
        <i class="fas fa-file-contract"></i><span>ລາຍງານທັງໝົດ</span>
        <i class="fas fa-chevron-down sidebar-arrow"></i>
      </button>
      <div class="sidebar-submenu">
        <%= link_to admin_reports_path,
            class: "submenu-link #{'active' if cp == '/admin/reports'}" do %>
          <i class="fas fa-file-invoice"></i>ລາຍງານລວມ (New)
        <% end %>
        <a href="/admin/reports" class="submenu-link"><i class="fas fa-calculator"></i>ການເງິນ & ບັນຊີ</a>
        <a href="/admin/reports" class="submenu-link"><i class="fas fa-globe-asia"></i>ຜູ້ໃຊ້ທົ່ວປະເທດ</a>
        <a href="/admin/reports" class="submenu-link"><i class="fas fa-car"></i>ສະຖິຕິພາຫານະ</a>
        <a href="/admin/reports" class="submenu-link"><i class="fas fa-university"></i>ຊຳລະຜ່ານທະນາຄານ</a>
        <a href="/admin/reports" class="submenu-link"><i class="fas fa-chart-line"></i>ລາຍຮັບລວມທັງໝົດ</a>
        <%= link_to admin_transactions_path,
            class: "submenu-link #{'active' if cp.start_with?('/admin/transactions')}" do %>
          <i class="fas fa-exchange-alt"></i>ລາຍງານຈຳນວນທຸລະກຳ
        <% end %>
      </div>
    </div>

    <%# ========== ອື່ນໆ ========== %>
    <p class="menu-header">ອື່ນໆ</p>

    <%# CRM dropdown %>
    <div class="sidebar-group">
      <button class="sidebar-link sidebar-group-btn" type="button">
        <i class="fas fa-users"></i><span>ຈັດການລູກຄ້າ CRM</span>
        <i class="fas fa-chevron-down sidebar-arrow"></i>
      </button>
      <div class="sidebar-submenu">
        <%= link_to admin_users_path, class: "submenu-link" do %>
          <i class="fas fa-chart-line"></i>Dashboard CRM
        <% end %>
        <a href="#" class="submenu-link"><i class="fas fa-history"></i>ປະຫວັດການໃຊ້ບໍລິການ</a>
        <a href="#" class="submenu-link"><i class="fas fa-star"></i>ຄວາມພໍໃຈລູກຄ້າ</a>
      </div>
    </div>

    <%# Partner dropdown %>
    <div class="sidebar-group">
      <button class="sidebar-link sidebar-group-btn" type="button">
        <i class="fas fa-handshake"></i><span>ຈັດການພາດເນີ</span>
        <i class="fas fa-chevron-down sidebar-arrow"></i>
      </button>
      <div class="sidebar-submenu">
        <%= link_to admin_admin_users_path(q: { role_eq: "partner" }), class: "submenu-link" do %>
          <i class="fas fa-chart-line"></i>Dashboard ພາດເນີ
        <% end %>
        <a href="#" class="submenu-link"><i class="fas fa-star"></i>Rating ພາດເນີ</a>
        <a href="#" class="submenu-link"><i class="fas fa-money-bill"></i>Commission</a>
        <a href="#" class="submenu-link"><i class="fas fa-history"></i>ປະຫວັດການເຮັດວຽກ</a>
      </div>
    </div>

    <%= link_to admin_activity_logs_path,
        class: "sidebar-link #{'active' if cp.start_with?('/admin/activity_logs')}" do %>
      <i class="fas fa-history"></i><span>ປະຫວັດ</span>
    <% end %>

    <%= link_to admin_advertisements_path,
        class: "sidebar-link #{'active' if cp.start_with?('/admin/advertisements')}" do %>
      <i class="fas fa-money-bill"></i><span>ຈັດການໂຄສະນາ</span>
    <% end %>

    <%= link_to admin_announcements_path,
        class: "sidebar-link #{'active' if cp.start_with?('/admin/announcements')}" do %>
      <i class="fas fa-bullhorn"></i><span>ປະກາດ</span>
    <% end %>

    <%# ========== ຕັ້ງຄ່າແອັບ ========== %>
    <p class="menu-header">ຕັ້ງຄ່າແອັບ</p>

    <%= link_to admin_onboarding_slides_path,
        class: "sidebar-link #{'active' if cp.start_with?('/admin/onboarding_slides')}" do %>
      <i class="fas fa-mobile-alt"></i><span>Onboarding Slides</span>
    <% end %>

    <%# ========== ລະບົບ ========== %>
    <p class="menu-header">ລະບົບ</p>

    <%= link_to admin_admin_users_path,
        class: "sidebar-link #{'active' if cp.start_with?('/admin/admin_users')}" do %>
      <i class="fas fa-user-shield"></i><span>ຜູ້ດູແລລະບົບ</span>
    <% end %>

    <% if current_admin_user.superadmin? %>
      <%= link_to admin_roles_path,
          class: "sidebar-link #{'active' if cp.start_with?('/admin/roles')}" do %>
        <i class="fas fa-shield-halved"></i><span>ຈັດການສິດທິ໌ (Roles)</span>
      <% end %>
    <% end %>

  <% end %>

  </nav>

  <%# ===== Footer ===== %>
  <div class="sidebar-footer">
    <div class="sidebar-user">
      <div class="user-avatar"><%= current_admin_user.email[0].upcase %></div>
      <div class="user-meta">
        <div class="user-name"><%= current_admin_user.email.split("@").first %></div>
        <div class="user-role"><%= current_admin_user.partner? ? "Partner" : current_admin_user.insurance? ? "Insurance" : current_admin_user.service_partner? ? "ພາດເນີສູນບໍລິການ" : "Administrator" %></div>
      </div>
    </div>
    <%= button_to "ອອກຈາກລະບົບ", destroy_admin_user_session_path,
        method: :delete, class: "logout-btn" %>
  </div>

</aside>

<script>
  document.querySelectorAll('.sidebar-group-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      this.closest('.sidebar-group').classList.toggle('open');
    });
  });
</script>
