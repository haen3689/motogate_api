<%
  center = resource
  vehicle_type_labels = {
    'motorcycle' => 'ລົດຈັກ', 'car' => 'ລົດເກັ່ງ', 'pickup' => 'ລົດກະບະ', 'suv' => 'ລົດຈິບ',
    'van' => 'ລົດຕູ້', 'bus' => 'ລົດເມ', 'towtruck' => 'ລົດລາກ', 'trailer' => 'ລົດພ່ວງ'
  }
%>

<style>
  #titlebar { display:none !important; }
  body.active_admin, #wrapper, #active_admin_content, #main_content,
  #main, .flashes { background:#f4f6f9 !important; }
  #main_content > .panel { background:transparent !important; border:none !important; box-shadow:none !important; padding:0 !important; margin:0 !important; }
  #main_content > .panel > .panel_contents { padding:0 !important; }

  .ics-page { --brand:#27bc9c; --brand-d:#1e9e82; --ink:#1f2a37; --muted:#6b7684; --line:#e9edf2; --soft:#f4f6f9;
              color:var(--ink); font-family:"Noto Sans Lao","Phetsarath OT",system-ui,sans-serif; max-width:1280px; }

  .ics-bar { display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom:28px; }
  .ics-bar-l { display:flex; align-items:center; gap:14px; }
  .ics-logo { width:56px; height:56px; border-radius:16px; display:flex; align-items:center; justify-content:center;
              overflow:hidden; background:#f1f5f9; border:1.5px solid var(--line); flex-shrink:0; }
  .ics-logo img { width:100%; height:100%; object-fit:contain; }
  .ics-logo i { color:#94a3b8; font-size:22px; }
  .ics-bar h2 { font-size:21px; font-weight:800; margin:0; }
  .ics-bar p  { font-size:12.5px; color:var(--muted); margin:3px 0 0; }
  .ics-bar-btns { display:flex; gap:10px; }
  .ics-btn { display:inline-flex; align-items:center; gap:7px; padding:10px 22px; border-radius:11px;
             font-size:13.5px; font-weight:700; cursor:pointer; text-decoration:none !important;
             border:none; transition:.15s; white-space:nowrap; font-family:inherit; }
  .ics-btn-edit { background:linear-gradient(135deg,#27bc9c,#1e9e82); color:#fff !important;
                  box-shadow:0 6px 16px rgba(39,188,156,.35); }
  .ics-btn-edit:hover { filter:brightness(1.07); color:#fff !important; transform:translateY(-1px); }
  .ics-btn-back { background:#fff; border:1.5px solid var(--line); color:var(--muted) !important;
                  box-shadow:0 2px 8px rgba(0,0,0,.06); }
  .ics-btn-back:hover { border-color:#27bc9c; color:#27bc9c !important; }

  .ics-status { display:inline-flex; align-items:center; gap:5px; padding:5px 14px; border-radius:20px; font-size:12.5px; font-weight:700; }
  .ics-status-active   { background:#dcfce7; color:#16a34a; }
  .ics-status-inactive { background:#fee2e2; color:#dc2626; }

  .ics-layout { display:grid; grid-template-columns:5fr 7fr; gap:20px; align-items:start; }
  @media (max-width:900px) { .ics-layout { grid-template-columns:1fr; } }

  .ics-card { background:#fff; border-radius:20px; box-shadow:0 4px 20px rgba(16,24,40,.06);
              padding:28px 32px; margin-bottom:20px; }
  .ics-card-hd { display:flex; align-items:center; gap:10px; font-size:15px; font-weight:800;
                 color:var(--ink); margin-bottom:20px; padding-bottom:14px; border-bottom:2px solid var(--soft); }
  .ics-card-hd i { width:32px; height:32px; border-radius:9px; display:grid; place-items:center;
                   background:#e6f7f3; color:#27bc9c; font-size:14px; flex-shrink:0; }

  .ics-row { display:flex; align-items:flex-start; gap:12px; padding:11px 0; border-bottom:1px solid var(--soft); }
  .ics-row:last-child { border-bottom:none; padding-bottom:0; }
  .ics-row i { width:30px; height:30px; border-radius:9px; background:var(--soft); color:#64748b;
               display:grid; place-items:center; font-size:13px; flex-shrink:0; }
  .ics-row-label { font-size:11.5px; font-weight:700; color:var(--muted); text-transform:uppercase; letter-spacing:.3px; margin:0 0 3px; }
  .ics-row-val { font-size:14px; font-weight:600; color:var(--ink); margin:0; word-break:break-word; }
  .ics-row-val a { color:#0f766e; font-weight:700; }

  #ics_map { height:220px; border-radius:12px; border:1.5px solid var(--line); margin-top:14px; }
  .ics-no-gps { color:#b0bac5; font-size:13px; }

  .ics-svc-empty { text-align:center; padding:32px 16px; color:var(--muted); font-size:13px; }
  .ics-svc-card { border:1.5px solid var(--line); border-radius:16px; padding:16px 20px;
                  margin-bottom:12px; background:#fbfcfd; }
  .ics-svc-card:last-child { margin-bottom:0; }
  .ics-svc-hd { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:10px; }
  .ics-svc-name { font-weight:700; font-size:14px; }
  .ics-svc-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(120px, 1fr)); gap:12px; margin-bottom:8px; }
  .ics-svc-field-label { font-size:10.5px; font-weight:700; color:var(--muted); text-transform:uppercase; letter-spacing:.3px; margin:0 0 3px; }
  .ics-svc-field-val { font-size:13px; font-weight:600; }
  .ics-svc-detail { font-size:12.5px; color:var(--muted); border-top:1px solid var(--soft); padding-top:8px; margin-top:4px; }
</style>

<div class="ics-page">

  <div class="ics-bar">
    <div class="ics-bar-l">
      <div class="ics-logo">
        <% if center.logo.present? %>
          <img src="<%= center.logo %>" alt="logo">
        <% else %>
          <i class="fas fa-warehouse"></i>
        <% end %>
      </div>
      <div>
        <h2><%= center.name %></h2>
        <p>ID #<%= center.id.to_s.rjust(4, '0') %>
          &nbsp;·&nbsp;
          <span class="ics-status <%= center.status == 'active' ? 'ics-status-active' : 'ics-status-inactive' %>">
            <%= center.status == 'active' ? 'ເປີດໃຫ້ບໍລິການ' : 'ປິດໃຫ້ບໍລິການ' %>
          </span>
        </p>
      </div>
    </div>
    <div class="ics-bar-btns">
      <%= link_to edit_admin_inspection_center_path(center), class: 'ics-btn ics-btn-edit' do %>
        <i class="fas fa-edit"></i>ແກ້ໄຂ
      <% end %>
      <%= link_to admin_inspection_centers_path, class: 'ics-btn ics-btn-back' do %>
        <i class="fas fa-arrow-left"></i>ກັບຄືນ
      <% end %>
    </div>
  </div>

  <div class="ics-layout">
    <%# ── Left: center info + GPS map ── %>
    <div>
      <div class="ics-card">
        <div class="ics-card-hd"><i class="fas fa-info-circle"></i>ຂໍ້ມູນສູນກວດກາເຕັກນິກ</div>

        <div class="ics-row">
          <i class="fas fa-phone-alt"></i>
          <div>
            <p class="ics-row-label">ເບີໂທລະສັບ</p>
            <p class="ics-row-val"><%= center.phone.presence || '—' %></p>
          </div>
        </div>
        <div class="ics-row">
          <i class="fas fa-map-marker-alt"></i>
          <div>
            <p class="ics-row-label">ທີ່ຕັ້ງຂອງສູນ</p>
            <p class="ics-row-val"><%= center.location.presence || '—' %></p>
          </div>
        </div>
        <div class="ics-row">
          <i class="fas fa-car"></i>
          <div>
            <p class="ics-row-label">ຮອງຮັບ (ຄັນ/ວັນ)</p>
            <p class="ics-row-val"><%= center.capacity_per_day.presence || '—' %></p>
          </div>
        </div>
        <div class="ics-row">
          <i class="fas fa-location-dot"></i>
          <div style="flex:1;">
            <p class="ics-row-label">ພິກັດ GPS</p>
            <% if center.latitude.present? && center.longitude.present? %>
              <p class="ics-row-val">
                <%= link_to "#{center.latitude}, #{center.longitude} (ເປີດໃນ Google Maps)",
                      "https://www.google.com/maps/search/?api=1&query=#{center.latitude},#{center.longitude}",
                      target: "_blank", rel: "noopener" %>
              </p>
              <div id="ics_map" data-lat="<%= center.latitude %>" data-lng="<%= center.longitude %>"></div>
            <% else %>
              <p class="ics-row-val ics-no-gps">ບໍ່ມີຂໍ້ມູນ</p>
            <% end %>
          </div>
        </div>
        <div class="ics-row">
          <i class="fas fa-clock"></i>
          <div>
            <p class="ics-row-label">ສ້າງເມື່ອ</p>
            <p class="ics-row-val"><%= center.created_at.strftime('%d/%m/%Y %H:%M') %></p>
          </div>
        </div>
      </div>
    </div>

    <%# ── Right: services list ── %>
    <div class="ics-card">
      <div class="ics-card-hd"><i class="fas fa-clipboard-list"></i>ລາຍການ/ຄ່າທຳນຽມ ການກວດກາ (<%= center.inspection_services.count %>)</div>

      <% if center.inspection_services.empty? %>
        <p class="ics-svc-empty">ຍັງບໍ່ມີລາຍການບໍລິການ</p>
      <% else %>
        <% center.inspection_services.each do |s| %>
          <div class="ics-svc-card">
            <div class="ics-svc-hd">
              <div class="ics-svc-name"><%= s.name %></div>
              <span class="ics-status <%= s.status == 'active' ? 'ics-status-active' : 'ics-status-inactive' %>">
                <%= s.status == 'active' ? 'ເປີດ' : 'ປິດ' %>
              </span>
            </div>
            <div class="ics-svc-grid">
              <div>
                <p class="ics-svc-field-label">ປະເພດລົດ</p>
                <p class="ics-svc-field-val"><%= vehicle_type_labels[s.vehicle_type] || 'ທຸກປະເພດ' %></p>
              </div>
              <div>
                <p class="ics-svc-field-label">ຊີຊີ (Min - Max)</p>
                <p class="ics-svc-field-val"><%= [s.min_cc, s.max_cc].compact.any? ? "#{s.min_cc.presence || '—'} - #{s.max_cc.presence || '—'}" : '—' %></p>
              </div>
              <div>
                <p class="ics-svc-field-label">ຄ່າທຳນຽມ</p>
                <p class="ics-svc-field-val"><%= s.price.present? ? number_to_currency(s.price, unit: "₭", precision: 0, delimiter: ",") : '—' %></p>
              </div>
            </div>
            <% if s.detail.present? %>
              <div class="ics-svc-detail"><%= s.detail %></div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script>
  (function () {
    function boot() {
      var mapDiv = document.getElementById('ics_map');
      if (!mapDiv || typeof L === 'undefined') return;
      var lat = parseFloat(mapDiv.dataset.lat);
      var lng = parseFloat(mapDiv.dataset.lng);
      if (isNaN(lat) || isNaN(lng)) return;

      var map = L.map(mapDiv, { zoomControl: false, dragging: false, scrollWheelZoom: false }).setView([lat, lng], 14);
      L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; OpenStreetMap &copy; CARTO', subdomains: 'abcd', maxZoom: 20
      }).addTo(map);
      L.marker([lat, lng]).addTo(map);
      setTimeout(function () { map.invalidateSize(); }, 200);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }
  })();
</script>
