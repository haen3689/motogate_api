<style>
  #titlebar { display:none !important; }
  .form-card { background:#fff; border-radius:20px; box-shadow:0 4px 20px rgba(0,0,0,.05); padding:24px; margin-bottom:20px; }
  .section-header { font-size:16px; font-weight:800; color:#1e293b; padding-bottom:14px; border-bottom:2px solid #f1f5f9; margin-bottom:20px; display:flex; align-items:center; gap:10px; }
  .section-header i { color:#27bc9c; }

  .plate-badge { border:2px solid #333; border-radius:8px; padding:8px 15px; display:inline-flex; flex-direction:column; justify-content:center; align-items:center; min-width:90px; text-align:center; box-shadow:0 2px 4px rgba(0,0,0,.1); }
  .plate-province { font-size:9px; font-weight:700; display:block; line-height:1; }
  .plate-number   { font-size:15px; font-weight:900; display:block; line-height:1.2; letter-spacing:1px; }
  .plate-yellow        { background:linear-gradient(135deg,#ffcc00,#ffdb4d); border-color:#333; }
  .plate-yellow        .plate-province, .plate-yellow        .plate-number { color:#000; }
  .plate-yellow-green  { background:linear-gradient(135deg,#ffcc00,#ffdb4d); border-color:#333; }
  .plate-yellow-green  .plate-province { color:#000; }
  .plate-yellow-green  .plate-number   { color:#16a34a; }
  .plate-yellow-blue   { background:linear-gradient(135deg,#ffcc00,#ffdb4d); border-color:#60a5fa; }
  .plate-yellow-blue   .plate-province, .plate-yellow-blue   .plate-number { color:#60a5fa; }
  .plate-blue          { background:linear-gradient(135deg,#1e3a8a,#1e3a8a); border-color:#1e3a8a; }
  .plate-blue          .plate-province, .plate-blue          .plate-number { color:#fff; }
  .plate-white         { background:linear-gradient(135deg,#fff,#f5f5f5); border-color:#333; }
  .plate-white         .plate-province, .plate-white         .plate-number { color:#000; }
  .plate-white-darkblue{ background:linear-gradient(135deg,#fff,#f5f5f5); border-color:#1e3a8a; }
  .plate-white-darkblue .plate-province,.plate-white-darkblue .plate-number{ color:#1e3a8a; }
  .plate-white-lightblue{ background:linear-gradient(135deg,#fff,#f5f5f5); border-color:#60a5fa; }
  .plate-white-lightblue .plate-province,.plate-white-lightblue .plate-number{ color:#60a5fa; }
  .plate-red           { background:linear-gradient(135deg,#dc2626,#b91c1c); border-color:#7f1d1d; }
  .plate-red           .plate-province, .plate-red           .plate-number { color:#fff; }
  .plate-red-underline { background:linear-gradient(135deg,#dc2626,#b91c1c); border-color:#7f1d1d; }
  .plate-red-underline .plate-province, .plate-red-underline .plate-number { color:#fff; }
  .plate-red-temp      { background:linear-gradient(135deg,#dc2626,#b91c1c); border-color:#7f1d1d; border-style:dashed; }
  .plate-red-temp      .plate-province, .plate-red-temp      .plate-number { color:#fff; }
  .plate-white-blue    { background:linear-gradient(135deg,#fff,#f5f5f5); border:3px solid #2563eb; }
  .plate-white-blue    .plate-province, .plate-white-blue    .plate-number { color:#000; }
  .plate-white-1percent{ background:linear-gradient(135deg,#2563eb,#1d4ed8); border-color:#2563eb; }
  .plate-white-1percent .plate-province,.plate-white-1percent .plate-number{ color:#fff; }
  .plate-white-foreign { background:linear-gradient(135deg,#fff,#f5f5f5); border-color:#60a5fa; }
  .plate-white-foreign .plate-province,.plate-white-foreign .plate-number { color:#60a5fa; }
  .plate-diplomat      { background:linear-gradient(135deg,#fff,#f5f5f5); border:2px solid #2563eb; }
  .plate-diplomat      .plate-province, .plate-diplomat      .plate-number { color:#2563eb; }
</style>

<div class="container-fluid" style="max-width:900px;">

  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1" style="font-size:.82rem;">
          <li class="breadcrumb-item">
            <%= link_to 'ຈັດການປ້າຍທະບຽນ', admin_plate_types_path, class:'text-decoration-none', style:'color:#27bc9c;' %>
          </li>
          <li class="breadcrumb-item active text-muted">
            <%= f.object.new_record? ? 'ເພີ່ມໃໝ່' : 'ແກ້ໄຂ' %>
          </li>
        </ol>
      </nav>
      <h4 class="fw-bold mb-0" style="color:#27bc9c;">
        <i class="fas fa-id-card me-2"></i><%= f.object.new_record? ? 'ເພີ່ມປ້າຍທະບຽນ' : 'ແກ້ໄຂປ້າຍທະບຽນ' %>
      </h4>
    </div>
    <div class="d-flex gap-2">
      <%= link_to admin_plate_types_path, class: 'btn btn-light border btn-sm px-3 text-muted' do %>
        <i class="fas fa-arrow-left me-1"></i>ກັບຄືນ
      <% end %>
    </div>
  </div>

  <%= f.semantic_errors %>

  <div class="form-card">
    <div class="section-header"><i class="fas fa-id-card"></i>ຂໍ້ມູນປ້າຍທະບຽນ</div>

    <div class="row g-3 mb-3">
      <div class="col-md-6">
        <label class="form-label small fw-bold">ລະຫັດປ້າຍ <span class="text-danger">*</span></label>
        <%= f.text_field :plate_code, class: 'form-control bg-light border-0 py-2', style: 'border-radius:8px;', placeholder: 'ຍົກຕົວຢ່າງ: ກນ, ກຊ, ປກສ...' %>
      </div>
      <div class="col-md-6">
        <label class="form-label small fw-bold">ຊື່ປ້າຍ <span class="text-danger">*</span></label>
        <%= f.text_field :name, class: 'form-control bg-light border-0 py-2', style: 'border-radius:8px;', placeholder: 'ຍົກຕົວຢ່າງ: ປ້າຍເຫຼືອງ - ສ່ວນບຸກຄົນ...' %>
      </div>
    </div>

    <div class="row g-3 mb-3">
      <div class="col-md-4">
        <label class="form-label small fw-bold">ສີ CSS Class</label>
        <%= f.select :color_class,
              [
                ['plate-yellow (ເຫຼືອງ - ສ່ວນບຸກຄົນ)',           'plate-yellow'],
                ['plate-blue (ຟ້າ - ລັດຖະບານ)',                  'plate-blue'],
                ['plate-white (ຂາວ - ບໍລິສັດ 100%)',              'plate-white'],
                ['plate-white-darkblue (ຂາວ - ອົງການສາກົນ)',      'plate-white-darkblue'],
                ['plate-white-lightblue (ຂາວ - ບໍລິສັດຮ່ວມທຸນ)', 'plate-white-lightblue'],
                ['plate-red-underline (ແດງ - ຕຳຫຼວດ/ປກສ)',        'plate-red-underline'],
                ['plate-red (ແດງ - ກອງທັບ)',                      'plate-red'],
                ['plate-white-1percent (ຟ້າ - 1%)',               'plate-white-1percent'],
                ['plate-white-foreign (ຂາວ - ຕ່າງດາວ)',           'plate-white-foreign'],
                ['plate-diplomat (ຂາວ - ສະຖານທູດ)',               'plate-diplomat'],
              ],
              {},
              class: 'form-select bg-light border-0 py-2', style: 'border-radius:8px;',
              id: 'plate_color_select', onchange: 'updatePreview()' %>
      </div>
      <div class="col-md-4">
        <label class="form-label small fw-bold d-block">ສະແດງແຂວງ</label>
        <div class="form-check mt-2">
          <%= f.check_box :show_province, class: 'form-check-input', style: 'width:18px;height:18px;cursor:pointer;', id: 'show_province_check', onchange: 'updatePreview()' %>
          <label class="form-check-label small ms-2" for="show_province_check" style="cursor:pointer;">
            ສະແດງຊື່ແຂວງໃນປ້າຍ
          </label>
        </div>
      </div>
      <div class="col-md-4">
        <label class="form-label small fw-bold">ສະຖານະ</label>
        <%= f.select :status,
              [['ເປີດໃຊ້ງານ', 'active'], ['ປິດໃຊ້ງານ', 'inactive']],
              {},
              class: 'form-select bg-light border-0 py-2', style: 'border-radius:8px;' %>
      </div>
    </div>

    <div class="row g-3 mb-3">
      <div class="col-md-4">
        <label class="form-label small fw-bold">ລຳດັບ</label>
        <%= f.number_field :position, class: 'form-control bg-light border-0 py-2', style: 'border-radius:8px;', min: 0 %>
      </div>
      <div class="col-md-8">
        <label class="form-label small fw-bold d-block">ຕົວຢ່າງປ້າຍ</label>
        <div id="plate-preview" class="plate-badge <%= f.object.color_class.presence || 'plate-yellow' %>">
          <span class="plate-province" id="preview-province" style="<%= f.object.show_province ? '' : 'display:none;' %>">ວຽງຈັນ</span>
          <span class="plate-number">
            <span id="preview-code"><%= f.object.plate_code.presence || 'ກນ' %></span> <span>1234</span>
          </span>
        </div>
      </div>
    </div>

    <div class="d-flex gap-2 mt-3">
      <%= f.submit f.object.new_record? ? 'ເພີ່ມປ້າຍທະບຽນ' : 'ບັນທຶກການແກ້ໄຂ',
            class: 'btn text-white px-4',
            style: 'background:linear-gradient(135deg,#27bc9c 0%,#1e9e82 100%);border:none;border-radius:8px;' %>
      <%= link_to 'ຍົກເລີກ', admin_plate_types_path,
            class: 'btn btn-light border px-4', style: 'border-radius:8px;' %>
    </div>
  </div>

</div>

<script>
function updatePreview() {
  var colorClass = document.getElementById('plate_color_select').value;
  var showProvince = document.getElementById('show_province_check').checked;
  var codeInput = document.querySelector('[name="plate_type[plate_code]"]');
  var code = codeInput ? codeInput.value || 'ກນ' : 'ກນ';

  var preview = document.getElementById('plate-preview');
  preview.className = 'plate-badge ' + colorClass;

  document.getElementById('preview-province').style.display = showProvince ? '' : 'none';
  document.getElementById('preview-code').textContent = code;
}

document.addEventListener('DOMContentLoaded', function() {
  var codeInput = document.querySelector('[name="plate_type[plate_code]"]');
  if (codeInput) {
    codeInput.addEventListener('input', updatePreview);
  }
});
</script>
