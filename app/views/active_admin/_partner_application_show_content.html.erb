<%
  a = resource
  type_label = { 'garage' => 'ສູນສ້ອມແປງລົດ', 'dealer' => 'ສູນຂາຍລົດ', 'towing' => 'ບໍລິການລາກລົດ 24ຊມ' }
  status_label = { "pending" => "ລໍຖ້າກວດສອບ", "approved" => "ອະນຸມັດແລ້ວ", "rejected" => "ປະຕິເສດ" }
  status_color = { "pending" => "#f59e0b", "approved" => "#16a34a", "rejected" => "#dc2626" }
%>

<style>
  #titlebar { display:none !important; }
  body.active_admin, #wrapper, #active_admin_content, #main_content,
  #main, .flashes { background:#f4f6f9 !important; }
  #main_content > .panel { background:transparent !important; border:none !important; box-shadow:none !important; padding:0 !important; margin:0 !important; }
  #main_content > .panel > .panel_contents { padding:0 !important; }

  .ics-page {
    --brand:#27bc9c; --brand-d:#1e9e82; --ink:#1f2a37; --muted:#6b7684; --line:#e9edf2; --soft:#f4f6f9;
    color:var(--ink); font-family:"Noto Sans Lao","Phetsarath OT",system-ui,sans-serif;
    max-width:700px;
  }
  .ics-bar { display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom:22px; }
  .ics-bar-l { display:flex; align-items:center; gap:14px; }
  .ics-bar-ico { width:50px; height:50px; border-radius:14px; display:grid; place-items:center;
                 background:linear-gradient(135deg,#27bc9c,#1e9e82); color:#fff; font-size:20px;
                 box-shadow:0 8px 20px rgba(39,188,156,.35); flex-shrink:0; }
  .ics-bar h2 { font-size:21px; font-weight:800; margin:0; }
  .ics-bar p  { font-size:12.5px; color:var(--muted); margin:3px 0 0; }
  .ics-bar-btns { display:flex; gap:10px; }
  .ics-btn { display:inline-flex; align-items:center; gap:7px; padding:10px 20px; border-radius:11px;
             font-size:13.5px; font-weight:700; cursor:pointer; text-decoration:none !important;
             border:none; transition:.15s; white-space:nowrap; font-family:inherit; }
  .ics-btn-back { background:#fff; border:1.5px solid var(--line); color:var(--muted) !important; }
  .ics-btn-back:hover { border-color:#27bc9c; color:#27bc9c !important; }
  .ics-btn-approve { background:#16a34a; color:#fff !important; }
  .ics-btn-reject { background:#dc2626; color:#fff !important; }

  .ics-card { background:#fff; border-radius:20px; box-shadow:0 4px 20px rgba(16,24,40,.06);
              padding:24px 26px; margin-bottom:20px; }
  .ics-g2 { display:grid; grid-template-columns:repeat(2,1fr); gap:20px; }
  .ics-lbl { font-size:11px; font-weight:700; color:var(--muted); text-transform:uppercase; letter-spacing:.4px; margin-bottom:4px; }
  .ics-val { font-size:14px; color:var(--ink); }
  .ics-val.muted { color:#b0bac5; font-style:italic; }
  .ics-status { display:inline-flex; align-items:center; gap:5px; padding:5px 12px; border-radius:20px; font-size:12px; font-weight:700; }
</style>

<div class="ics-page">
  <div class="ics-bar">
    <div class="ics-bar-l">
      <div class="ics-bar-ico"><i class="fas fa-user-plus"></i></div>
      <div>
        <h2><%= a.business_name %></h2>
        <p><%= type_label[a.service_type] %></p>
      </div>
    </div>
    <div class="ics-bar-btns">
      <% if a.status == "pending" %>
        <%= button_to approve_admin_partner_application_path(a), method: :post, class: 'ics-btn ics-btn-approve' do %>
          <i class="fas fa-check"></i>ອະນຸມັດ
        <% end %>
        <%= button_to reject_admin_partner_application_path(a), method: :post, class: 'ics-btn ics-btn-reject', data: { confirm: "ຢືນຢັນການປະຕິເສດ?" } do %>
          <i class="fas fa-times"></i>ປະຕິເສດ
        <% end %>
      <% end %>
      <%= link_to admin_partner_applications_path(type: a.service_type), class: 'ics-btn ics-btn-back' do %>
        <i class="fas fa-arrow-left"></i>ກັບຄືນ
      <% end %>
    </div>
  </div>

  <div class="ics-card">
    <div class="ics-g2">
      <div>
        <div class="ics-lbl">ສະຖານະ</div>
        <div class="ics-val">
          <span class="ics-status" style="background:<%= status_color[a.status] %>1a;color:<%= status_color[a.status] %>;">
            <%= status_label[a.status] %>
          </span>
        </div>
      </div>
      <div>
        <div class="ics-lbl">ວັນທີ່ສະໝັກ</div>
        <div class="ics-val"><%= a.created_at.strftime('%d/%m/%Y %H:%M') %></div>
      </div>
      <div>
        <div class="ics-lbl">ຊື່ຜູ້ຕິດຕໍ່</div>
        <div class="ics-val <%= 'muted' unless a.owner_name.present? %>"><%= a.owner_name.presence || "ບໍ່ມີ" %></div>
      </div>
      <div>
        <div class="ics-lbl">ເບີໂທ</div>
        <div class="ics-val <%= 'muted' unless a.phone.present? %>"><%= a.phone.presence || "ບໍ່ມີ" %></div>
      </div>
      <div style="grid-column:1 / -1;">
        <div class="ics-lbl">ທີ່ຢູ່</div>
        <div class="ics-val <%= 'muted' unless a.location.present? %>"><%= a.location.presence || "ບໍ່ມີ" %></div>
      </div>
      <% if a.notes.present? %>
        <div style="grid-column:1 / -1;">
          <div class="ics-lbl">ໝາຍເຫດ</div>
          <div class="ics-val"><%= a.notes %></div>
        </div>
      <% end %>
      <% if a.service_center %>
        <div style="grid-column:1 / -1;">
          <div class="ics-lbl">ສູນບໍລິການທີ່ສ້າງ</div>
          <div class="ics-val"><%= link_to a.service_center.name, admin_service_center_path(a.service_center), style: "color:#27bc9c;" %></div>
        </div>
      <% end %>
    </div>
  </div>
</div>
