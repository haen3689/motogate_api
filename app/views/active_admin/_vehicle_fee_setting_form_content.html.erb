<% s = resource %>

<style>
  #titlebar { display:none !important; }
  body.active_admin, #wrapper, #active_admin_content, #main_content,
  #main, .flashes { background:#f4f6f9 !important; }
  #main_content > .panel { background:transparent !important; border:none !important; box-shadow:none !important; padding:0 !important; margin:0 !important; }
  #main_content > .panel > .panel_contents { padding:0 !important; }

  .vfs-page {
    --brand:#27bc9c; --brand-d:#1e9e82; --ink:#1f2a37; --muted:#6b7684; --line:#e9edf2; --soft:#f4f6f9;
    color:var(--ink); font-family:"Noto Sans Lao","Phetsarath OT",system-ui,sans-serif;
    max-width:640px;
  }

  .vfs-bar { display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom:28px; }
  .vfs-bar-l { display:flex; align-items:center; gap:14px; }
  .vfs-bar-ico { width:50px; height:50px; border-radius:14px; display:grid; place-items:center;
                 background:linear-gradient(135deg,#27bc9c,#1e9e82); color:#fff; font-size:20px;
                 box-shadow:0 8px 20px rgba(39,188,156,.35); flex-shrink:0; }
  .vfs-bar h2 { font-size:21px; font-weight:800; margin:0; }
  .vfs-bar p  { font-size:12.5px; color:var(--muted); margin:3px 0 0; }
  .vfs-btn { display:inline-flex; align-items:center; gap:7px; padding:10px 22px; border-radius:11px;
             font-size:13.5px; font-weight:700; cursor:pointer; text-decoration:none !important;
             text-shadow:none !important; border:none; transition:.15s; white-space:nowrap;
             font-family:inherit; }
  .vfs-btn-save { background:linear-gradient(135deg,#27bc9c,#1e9e82); color:#fff !important;
                  box-shadow:0 6px 16px rgba(39,188,156,.35); }
  .vfs-btn-save:hover { filter:brightness(1.07); color:#fff !important; transform:translateY(-1px); }

  .vfs-card { background:#fff; border-radius:20px; box-shadow:0 4px 20px rgba(16,24,40,.06);
              padding:28px 32px; margin-bottom:20px; }
  .vfs-card-hd { display:flex; align-items:center; gap:10px; font-size:15px; font-weight:800;
                 color:var(--ink); margin-bottom:24px; padding-bottom:14px;
                 border-bottom:2px solid var(--soft); }
  .vfs-card-hd i { width:32px; height:32px; border-radius:9px; display:grid; place-items:center;
                   background:#e6f7f3; color:#27bc9c; font-size:14px; flex-shrink:0; }

  .vfs-field { display:flex; flex-direction:column; gap:6px; }
  .vfs-label { font-size:12px; font-weight:700; color:#475569; letter-spacing:.02em; text-transform:uppercase; }
  .vfs-input {
    border:1.5px solid var(--line) !important; border-radius:10px !important;
    padding:11px 14px !important; font-size:13.5px !important; background:#fff !important;
    outline:none !important; font-family:inherit !important; color:var(--ink) !important;
    transition:.2s; width:100% !important; box-sizing:border-box !important;
    min-height:44px !important; line-height:1.4 !important; margin:0 !important;
    box-shadow:none !important; appearance:none; -webkit-appearance:none;
  }
  .vfs-input:focus { border-color:#27bc9c !important; box-shadow:0 0 0 3px rgba(39,188,156,.13) !important; }
  .vfs-hint { font-size:11.5px; color:var(--muted); margin-top:2px; }

  .vfs-errors { background:#fff1f2; border:1.5px solid #fca5a5; border-radius:14px;
                padding:16px 22px; margin-bottom:20px; }
  .vfs-errors strong { color:#dc2626; display:block; margin-bottom:8px; }
  .vfs-errors li { color:#dc2626; font-size:13px; margin-bottom:2px; }
</style>

<div class="vfs-page">
  <%= form_with model: [:admin, s], local: true, html: { style:"margin:0;" } do |f| %>

    <div class="vfs-bar">
      <div class="vfs-bar-l">
        <div class="vfs-bar-ico"><i class="fas fa-car"></i></div>
        <div>
          <h2>ຕັ້ງຄ່າ ຄ່າທຳນຽມລົງທະບຽນລົດ</h2>
          <p>ຄ່າທຳນຽມເທື່ອດຽວ ຈ່າຍຜ່ານແອບຫຼັງເພີ່ມລົດໃໝ່</p>
        </div>
      </div>
      <%= f.submit 'ບັນທຶກການແກ້ໄຂ', class: 'vfs-btn vfs-btn-save' %>
    </div>

    <% if s.errors.any? %>
      <div class="vfs-errors">
        <strong><i class="fas fa-exclamation-circle" style="margin-right:6px;"></i>ກະລຸນາກວດສອບຂໍ້ມູນ</strong>
        <ul style="margin:0;padding-left:18px;">
          <% s.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="vfs-card">
      <div class="vfs-card-hd"><i class="fas fa-coins"></i>ຈຳນວນເງິນ</div>

      <div class="vfs-field">
        <label class="vfs-label">ຄ່າທຳນຽມ (₭)</label>
        <%= f.number_field :amount, class: 'vfs-input', placeholder: '200000' %>
        <p class="vfs-hint">ຈຳນວນເງິນຄົງທີ່ ທີ່ຈະຄິດຄ່າທຳນຽມລົງທະບຽນລົດໃໝ່ທຸກຄັນ (ຜ່ານ BCEL OnePay)</p>
      </div>
    </div>

  <% end %>
</div>
