<%
  filter_search = params.dig(:q, :search)
  filter_status = params.dig(:q, :status)

  scope = InsuranceCompany.left_joins(:insurance_packages).select("insurance_companies.*, COUNT(insurance_packages.id) AS packages_count").group("insurance_companies.id").order(name: :asc)
  scope = scope.where("insurance_companies.name ILIKE :q OR insurance_companies.phone ILIKE :q OR insurance_companies.email ILIKE :q", q: "%#{filter_search.strip}%") if filter_search.present?
  scope = scope.where(status: filter_status) if filter_status.present?

  page     = (params[:page] || 1).to_i
  per_page = 20
  companies = scope.page(page).per(per_page)

  total          = InsuranceCompany.count
  active_count   = InsuranceCompany.where(status: 'active').count
  inactive_count = total - active_count
  packages_count = InsurancePackage.count
  has_filter     = filter_search.present? || filter_status.present?
%>

<style>
  .index_content .scopes, #titlebar { display:none !important; }
  body.active_admin, #wrapper, #active_admin_content, #main_content,
  .index_content, #main, .flashes { background:#f4f6f9 !important; }
  .index_content > .panel,
  .index_as_table,
  #main_content .panel:first-child { background:transparent !important; border:none !important; box-shadow:none !important; padding:0 !important; margin:0 !important; }
  .index_content > .panel > .panel_contents,
  .index_as_table > .panel_contents { padding:0 !important; background:transparent !important; }

  .ic-page { --brand:#27bc9c; --brand-d:#1e9e82; --ink:#1f2a37; --muted:#6b7684; --line:#e9edf2;
             color:var(--ink); font-family:"Noto Sans Lao","Phetsarath OT",system-ui,sans-serif; }

  .ic-head { display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom:24px; }
  .ic-head-l { display:flex; align-items:center; gap:14px; }
  .ic-head-ico { width:48px; height:48px; border-radius:14px; display:grid; place-items:center;
                 color:#fff; font-size:20px; background:linear-gradient(135deg,#27bc9c,#1e9e82);
                 box-shadow:0 8px 18px rgba(39,188,156,.35); flex-shrink:0; }
  .ic-head h2 { font-size:20px; font-weight:800; margin:0; letter-spacing:-.2px; }
  .ic-head p  { font-size:12.5px; color:var(--muted); margin:3px 0 0; }
  .ic-btn-add { border:none; border-radius:11px; padding:10px 20px; font-size:13.5px; font-weight:700;
                background:linear-gradient(135deg,#27bc9c,#1e9e82); color:#fff !important;
                box-shadow:0 6px 14px rgba(39,188,156,.32); cursor:pointer; display:inline-flex;
                align-items:center; gap:8px; text-decoration:none !important; transition:.15s; }
  .ic-btn-add:hover { filter:brightness(1.06); color:#fff !important; transform:translateY(-1px); }

  .ic-stats { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:22px; }
  .ic-stat { background:#fff; border-radius:16px; padding:18px 20px;
             box-shadow:0 4px 16px rgba(16,24,40,.05); display:flex; align-items:center; gap:16px;
             border-left:4px solid transparent; }
  .ic-stat.teal  { border-left-color:#27bc9c; }
  .ic-stat.green { border-left-color:#16a34a; }
  .ic-stat.red   { border-left-color:#dc2626; }
  .ic-stat.blue  { border-left-color:#2563eb; }
  .ic-stat-ico { width:44px; height:44px; border-radius:12px; display:grid; place-items:center; font-size:18px; flex-shrink:0; }
  .ic-stat.teal  .ic-stat-ico { background:#e6f7f3; color:#27bc9c; }
  .ic-stat.green .ic-stat-ico { background:#dcfce7; color:#16a34a; }
  .ic-stat.red   .ic-stat-ico { background:#fee2e2; color:#dc2626; }
  .ic-stat.blue  .ic-stat-ico { background:#dbeafe; color:#2563eb; }
  .ic-stat-label { font-size:12px; color:var(--muted); font-weight:600; margin:0 0 4px; }
  .ic-stat-val   { font-size:24px; font-weight:800; margin:0; letter-spacing:-.5px; }

  .ic-filter { background:#fff; border-radius:16px; padding:18px 20px; margin-bottom:20px;
               box-shadow:0 4px 16px rgba(16,24,40,.05); }
  .ic-filter-label { display:block; font-size:12.5px; font-weight:700; color:#334155; margin-bottom:6px; }
  .ic-filter-input { width:100%; border:1px solid var(--line); border-radius:10px; padding:10px 14px;
                     font-size:13.5px; background:#fff; outline:none;
                     font-family:inherit; color:var(--ink); }
  .ic-filter-input:focus { border-color:#27bc9c; box-shadow:0 0 0 3px rgba(39,188,156,.12); }
  .ic-filter-row { display:flex !important; flex-direction:row !important; gap:12px; align-items:flex-end; flex-wrap:nowrap; }
  .ic-filter-search { flex:2.5; min-width:0; }
  .ic-filter-sel    { flex:1.5; min-width:0; }
  .ic-filter-btns   { flex-shrink:0; display:flex; flex-direction:column; gap:6px; }
  .ic-btn-filter { border:none; border-radius:10px; padding:10px 18px; font-size:13.5px; font-weight:700;
                   background:#1f2a37; color:#fff; cursor:pointer; display:inline-flex; align-items:center; gap:6px;
                   white-space:nowrap; width:100%; justify-content:center; min-height:44px; box-sizing:border-box; }
  .ic-btn-filter:hover { background:#374151; }
  .ic-btn-clear { border:1px solid var(--line); border-radius:10px; padding:10px 18px; font-size:13.5px;
                  font-weight:600; background:#fff; text-decoration:none !important;
                  display:inline-flex; align-items:center; gap:6px; white-space:nowrap;
                  width:100%; justify-content:center; color:var(--muted) !important;
                  min-height:44px; box-sizing:border-box; }
  .ic-btn-clear:hover { background:#f8fafc; color:var(--ink) !important; }

  .ic-table-card { background:#fff; border-radius:20px; overflow:hidden; box-shadow:0 4px 20px rgba(16,24,40,.06); }
  .ic-table { width:100%; border-collapse:collapse; }
  .ic-table thead th { background:#f8fafc; padding:12px 14px; font-size:12px; font-weight:700;
                       color:var(--muted); text-transform:uppercase; letter-spacing:.5px;
                       border-bottom:1px solid var(--line); white-space:nowrap; }
  .ic-table thead th:first-child { padding-left:20px; }
  .ic-table thead th:last-child  { padding-right:20px; text-align:center; }
  .ic-table tbody td { padding:12px 14px; font-size:13.5px; border-bottom:1px solid var(--line); vertical-align:middle; }
  .ic-table tbody td:first-child { padding-left:20px; }
  .ic-table tbody td:last-child  { padding-right:20px; text-align:center; }
  .ic-table tbody tr:last-child td { border-bottom:none; }
  .ic-table tbody tr:hover td { background:#fafcfb; }

  .ic-logo { width:44px; height:44px; border-radius:50%; background:#f1f5f9; display:flex;
             align-items:center; justify-content:center; overflow:hidden; border:1px solid var(--line); flex-shrink:0; }
  .ic-logo img { width:100%; height:100%; object-fit:contain; }
  .ic-logo i { color:#94a3b8; font-size:16px; }

  .ic-status { display:inline-block; padding:5px 12px; border-radius:20px; font-size:12px; font-weight:600; white-space:nowrap; }
  .ic-status-active   { background:#dcfce7; color:#16a34a; }
  .ic-status-inactive { background:#fee2e2; color:#dc2626; }

  .ic-badge { display:inline-flex; align-items:center; gap:5px; padding:4px 12px; border-radius:20px;
              background:#e0f2fe; color:#0369a1; font-size:12px; font-weight:700; }

  .ic-actions { display:flex; gap:5px; justify-content:center; }
  .ic-btn-view { border:1px solid #0ea5e9; background:#f0f9ff; color:#0369a1 !important; border-radius:7px;
                 padding:5px 10px; font-size:12px; font-weight:700; text-decoration:none !important;
                 display:inline-flex; align-items:center; gap:4px; transition:.15s; }
  .ic-btn-view:hover { background:#0ea5e9; color:#fff !important; }
  .ic-btn-edit { border:1px solid #16a34a; background:#f0fdf4; color:#15803d !important; border-radius:7px;
                 padding:5px 10px; font-size:12px; font-weight:700; text-decoration:none !important;
                 display:inline-flex; align-items:center; gap:4px; transition:.15s; }
  .ic-btn-edit:hover { background:#16a34a; color:#fff !important; }
  .ic-btn-del { border:1px solid #f87171; background:#fff1f2; color:#991b1b; border-radius:7px;
                padding:5px 10px; font-size:12px; font-weight:700; cursor:pointer;
                display:inline-flex; align-items:center; gap:4px; transition:.15s; }
  .ic-btn-del:hover { background:#dc2626; color:#fff; border-color:#dc2626; }
  .ic-btn-del form { margin:0; }

  .ic-empty { text-align:center; padding:60px 20px; }
  .ic-empty i { font-size:3rem; color:#cbd5e1; display:block; margin-bottom:12px; }
  .ic-empty p { color:var(--muted); font-size:14px; margin:0; }

  .ic-page-wrap .pagination .page.current a,
  .ic-page-wrap .pagination .page.current span { background:#27bc9c; border-color:#27bc9c; color:#fff; border-radius:8px; }
  .ic-page-wrap .pagination a, .ic-page-wrap .pagination span { border-radius:8px; }
</style>

<div class="ic-page">

  <div class="ic-head">
    <div class="ic-head-l">
      <div class="ic-head-ico"><i class="fas fa-building"></i></div>
      <div>
        <h2>ຈັດການບໍລິສັດປະກັນໄພ</h2>
        <p>ບໍລິຫານຈັດການຂໍ້ມູນບໍລິສັດປະກັນໄພ ແລະ ແພັກເກັດຕ່າງໆ</p>
      </div>
    </div>
    <%= link_to new_admin_insurance_company_path, class: 'ic-btn-add' do %>
      <i class="fas fa-plus"></i>ເພີ່ມບໍລິສັດໃໝ່
    <% end %>
  </div>

  <div class="ic-stats">
    <div class="ic-stat teal">
      <div class="ic-stat-ico"><i class="fas fa-building"></i></div>
      <div>
        <p class="ic-stat-label">ບໍລິສັດທັງໝົດ</p>
        <p class="ic-stat-val"><%= number_with_delimiter(total) %></p>
      </div>
    </div>
    <div class="ic-stat green">
      <div class="ic-stat-ico"><i class="fas fa-check-circle"></i></div>
      <div>
        <p class="ic-stat-label">ເປີດໃຊ້ງານ</p>
        <p class="ic-stat-val"><%= number_with_delimiter(active_count) %></p>
      </div>
    </div>
    <div class="ic-stat red">
      <div class="ic-stat-ico"><i class="fas fa-times-circle"></i></div>
      <div>
        <p class="ic-stat-label">ປິດໃຊ້ງານ</p>
        <p class="ic-stat-val"><%= number_with_delimiter(inactive_count) %></p>
      </div>
    </div>
    <div class="ic-stat blue">
      <div class="ic-stat-ico"><i class="fas fa-box-open"></i></div>
      <div>
        <p class="ic-stat-label">ແພັກເກັດທັງໝົດ</p>
        <p class="ic-stat-val"><%= number_with_delimiter(packages_count) %></p>
      </div>
    </div>
  </div>

  <div class="ic-filter">
    <form method="GET" action="<%= admin_insurance_companies_path %>">
      <div class="ic-filter-row">
        <div class="ic-filter-search">
          <label class="ic-filter-label">ຄົ້ນຫາ</label>
          <input type="text" name="q[search]" class="ic-filter-input"
                 value="<%= filter_search %>" placeholder="ຊື່, ເບີໂທ, ອີເມວ...">
        </div>
        <div class="ic-filter-sel">
          <label class="ic-filter-label">ສະຖານະ</label>
          <select name="q[status]" class="ic-filter-input">
            <option value="">ທັງໝົດ</option>
            <option value="active"   <%= 'selected' if filter_status == 'active'   %>>ເປີດໃຊ້ງານ</option>
            <option value="inactive" <%= 'selected' if filter_status == 'inactive' %>>ປິດໃຊ້ງານ</option>
          </select>
        </div>
        <div class="ic-filter-btns">
          <button type="submit" class="ic-btn-filter">
            <i class="fas fa-filter"></i>ກອງຂໍ້ມູນ
          </button>
          <% if has_filter %>
            <a href="<%= admin_insurance_companies_path %>" class="ic-btn-clear">
              <i class="fas fa-times"></i>ລ້າງ
            </a>
          <% end %>
        </div>
      </div>
    </form>
  </div>

  <div class="ic-table-card">
    <div style="overflow-x:auto;">
      <table class="ic-table">
        <thead>
          <tr>
            <th>ໂລໂກ້</th>
            <th>ຊື່ບໍລິສັດ</th>
            <th>ຕິດຕໍ່</th>
            <th>ແພັກເກັດ</th>
            <th>ວັນທີເພີ່ມ</th>
            <th>ສະຖານະ</th>
            <th>ຈັດການ</th>
          </tr>
        </thead>
        <tbody>
          <% companies.each do |c| %>
            <tr>
              <td>
                <div class="ic-logo">
                  <% if c.logo.present? %>
                    <img src="<%= c.logo %>" alt="logo">
                  <% else %>
                    <i class="fas fa-building"></i>
                  <% end %>
                </div>
              </td>
              <td>
                <div style="font-weight:700;font-size:13.5px;"><%= c.name %></div>
                <% if c.description.present? %>
                  <div style="font-size:12px;color:#94a3b8;"><%= truncate(c.description, length: 60) %></div>
                <% elsif c.email.present? %>
                  <div style="font-size:12px;color:#94a3b8;"><%= c.email %></div>
                <% end %>
              </td>
              <td style="font-size:13px;color:var(--muted);"><%= c.phone.presence || '—' %></td>
              <td>
                <span class="ic-badge"><i class="fas fa-box-open"></i> <%= c.packages_count %> ແພັກເກັດ</span>
              </td>
              <td style="font-size:13px;color:var(--muted);"><%= c.created_at.strftime('%d/%m/%Y') %></td>
              <td>
                <span class="ic-status <%= c.status == 'active' ? 'ic-status-active' : 'ic-status-inactive' %>">
                  <%= c.status == 'active' ? 'ເປີດໃຊ້ງານ' : 'ປິດໃຊ້ງານ' %>
                </span>
              </td>
              <td>
                <div class="ic-actions">
                  <%= link_to admin_insurance_company_path(c), class: 'ic-btn-view' do %>
                    <i class="fas fa-eye"></i>
                  <% end %>
                  <%= link_to edit_admin_insurance_company_path(c), class: 'ic-btn-edit' do %>
                    <i class="fas fa-edit"></i>
                  <% end %>
                  <%= button_to admin_insurance_company_path(c), method: :delete,
                        class: 'ic-btn-del',
                        form: { style: 'margin:0;' },
                        data: { confirm: "ຢືນຢັນການລົບບໍລິສັດ #{c.name}?" } do %>
                    <i class="fas fa-trash"></i>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>

          <% if companies.empty? %>
            <tr>
              <td colspan="7">
                <div class="ic-empty">
                  <i class="fas fa-building"></i>
                  <p>ບໍ່ພົບຂໍ້ມູນບໍລິສັດປະກັນໄພ</p>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <% if companies.respond_to?(:total_pages) && companies.total_pages > 1 %>
    <div class="ic-page-wrap" style="display:flex;justify-content:center;margin-top:20px;">
      <%= paginate companies %>
    </div>
  <% end %>

</div>
