<%
  c = resource
  status_label = { "active" => "ໃຊ້ງານຢູ່", "pending" => "ລໍຖ້າ", "expired" => "ໝົດອາຍຸ", "terminated" => "ຍົກເລີກ" }
  status_color = { "active" => "#16a34a", "pending" => "#f59e0b", "expired" => "#64748b", "terminated" => "#dc2626" }
  type_label = { 'garage' => 'ສູນສ້ອມແປງລົດ', 'dealer' => 'ສູນຂາຍລົດ', 'towing' => 'ລາກລົດ 24ຊມ' }
%>

<style>
  #titlebar { display:none !important; }
  body.active_admin, #wrapper, #active_admin_content, #main_content,
  #main, .flashes { background:#f4f6f9 !important; }
  #main_content > .panel { background:transparent !important; border:none !important; box-shadow:none !important; padding:0 !important; margin:0 !important; }
  #main_content > .panel > .panel_contents { padding:0 !important; }

  .ics-page {
    --brand:#27bc9c; --brand-d:#1e9e82; --ink:#1f2a37; --muted:#6b7684; --line:#e9edf2; --soft:#f4f6f9;
    color:var(--ink); font-family:"Noto Sans Lao","Phetsarath OT",system-ui,sans-serif;
    max-width:900px;
  }

  .ics-bar { display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom:22px; }
  .ics-bar-l { display:flex; align-items:center; gap:14px; }
  .ics-bar-ico { width:50px; height:50px; border-radius:14px; display:grid; place-items:center;
                 background:linear-gradient(135deg,#27bc9c,#1e9e82); color:#fff; font-size:20px;
                 box-shadow:0 8px 20px rgba(39,188,156,.35); flex-shrink:0; }
  .ics-bar h2 { font-size:21px; font-weight:800; margin:0; }
  .ics-bar p  { font-size:12.5px; color:var(--muted); margin:3px 0 0; }
  .ics-bar-btns { display:flex; gap:10px; }
  .ics-btn { display:inline-flex; align-items:center; gap:7px; padding:10px 20px; border-radius:11px;
             font-size:13.5px; font-weight:700; cursor:pointer; text-decoration:none !important;
             text-shadow:none !important; border:none; transition:.15s; white-space:nowrap;
             font-family:inherit; }
  .ics-btn-edit { background:linear-gradient(135deg,#27bc9c,#1e9e82); color:#fff !important;
                  box-shadow:0 6px 16px rgba(39,188,156,.35); }
  .ics-btn-edit:hover { filter:brightness(1.07); color:#fff !important; transform:translateY(-1px); }
  .ics-btn-back { background:#fff; border:1.5px solid var(--line); color:var(--muted) !important;
                  box-shadow:0 2px 8px rgba(0,0,0,.06); }
  .ics-btn-back:hover { border-color:#27bc9c; color:#27bc9c !important; }

  .ics-hero { background:#fff; border-radius:20px; box-shadow:0 4px 20px rgba(16,24,40,.06);
              padding:26px 28px; margin-bottom:20px; display:flex; align-items:center; gap:24px; flex-wrap:wrap; }
  .ics-avatar { width:76px; height:76px; border-radius:20px; background:#e6f7f3; color:#27bc9c;
                display:flex; align-items:center; justify-content:center; font-size:28px; flex-shrink:0; }
  .ics-hero-info { flex:1; min-width:200px; }
  .ics-hero-info h3 { font-size:19px; font-weight:800; margin:0 0 8px; }
  .ics-hero-meta { display:flex; align-items:center; gap:14px; flex-wrap:wrap; font-size:12.5px; color:var(--muted); }
  .ics-status { display:inline-flex; align-items:center; gap:5px; padding:5px 12px; border-radius:20px; font-size:12px; font-weight:700; }
  .ics-hero-stats { display:flex; gap:12px; flex-shrink:0; }
  .ics-stat-box { text-align:center; background:var(--soft); border-radius:14px; padding:12px 20px; min-width:100px; }
  .ics-stat-box .val { font-size:20px; font-weight:800; color:var(--brand-d); letter-spacing:-.5px; }
  .ics-stat-box .lbl { font-size:11px; color:var(--muted); font-weight:600; margin-top:2px; }

  .ics-card { background:#fff; border-radius:20px; box-shadow:0 4px 20px rgba(16,24,40,.06);
              padding:24px 26px; margin-bottom:20px; }
  .ics-card-hd { display:flex; align-items:center; justify-content:space-between; gap:10px; font-size:15px; font-weight:800;
                 color:var(--ink); margin-bottom:18px; padding-bottom:14px; border-bottom:2px solid var(--soft); }
  .ics-card-hd-l { display:flex; align-items:center; gap:10px; }
  .ics-card-hd i { width:32px; height:32px; border-radius:9px; display:grid; place-items:center;
                   background:#e6f7f3; color:#27bc9c; font-size:14px; flex-shrink:0; }
  .ics-g2 { display:grid; grid-template-columns:repeat(2,1fr); gap:20px; }
  .ics-lbl { font-size:11px; font-weight:700; color:var(--muted); text-transform:uppercase; letter-spacing:.4px; margin-bottom:4px; }
  .ics-val { font-size:14px; color:var(--ink); }
  .ics-val.muted { color:#b0bac5; font-style:italic; }

  .pay-form { display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap; margin-bottom:18px; padding-bottom:18px; border-bottom:1.5px dashed var(--line); }
  .pay-field { display:flex; flex-direction:column; gap:4px; }
  .pay-field label { font-size:11px; font-weight:700; color:var(--muted); text-transform:uppercase; }
  .pay-input { border:1.5px solid var(--line); border-radius:9px; padding:9px 12px; font-size:13px; font-family:inherit; min-height:40px; box-sizing:border-box; }
  .pay-btn { border:none; background:#27bc9c; color:#fff; border-radius:9px; padding:9px 18px; font-size:13px; font-weight:700; cursor:pointer; height:40px; }
  .pay-btn:hover { background:#1e9e82; }

  .ics-table { width:100%; border-collapse:collapse; font-size:13px; }
  .ics-table th { text-align:left; padding:8px 10px; color:var(--muted); font-weight:700; font-size:11px; text-transform:uppercase; border-bottom:1.5px solid var(--soft); }
  .ics-table td { padding:10px; border-bottom:1px solid var(--soft); }
</style>

<div class="ics-page">
  <div class="ics-bar">
    <div class="ics-bar-l">
      <div class="ics-bar-ico"><i class="fas fa-file-contract"></i></div>
      <div>
        <h2><%= c.contract_number %></h2>
        <p><%= c.service_center.name %> · <%= type_label[c.service_center.service_type] %></p>
      </div>
    </div>
    <div class="ics-bar-btns">
      <% unless current_admin_user.service_partner? %>
        <%= link_to edit_admin_service_center_contract_path(c), class: 'ics-btn ics-btn-edit' do %>
          <i class="fas fa-edit"></i>ແກ້ໄຂ
        <% end %>
      <% end %>
      <%= link_to admin_service_center_contracts_path(q: { type: c.service_center.service_type }), class: 'ics-btn ics-btn-back' do %>
        <i class="fas fa-arrow-left"></i>ກັບຄືນ
      <% end %>
    </div>
  </div>

  <div class="ics-hero">
    <div class="ics-avatar"><i class="fas fa-file-contract"></i></div>
    <div class="ics-hero-info">
      <h3><%= link_to c.service_center.name, admin_service_center_path(c.service_center), style: "color:inherit;" %></h3>
      <div class="ics-hero-meta">
        <span class="ics-status" style="background:<%= status_color[c.effective_status] %>1a;color:<%= status_color[c.effective_status] %>;">
          <%= status_label[c.effective_status] %>
        </span>
      </div>
    </div>
    <div class="ics-hero-stats">
      <div class="ics-stat-box">
        <div class="val"><%= number_to_currency(c.rent_amount, unit: "₭", precision: 0, delimiter: ",") %></div>
        <div class="lbl">ຄ່າເຊົ່າ/<%= c.billing_cycle == 'monthly' ? 'ເດືອນ' : 'ປີ' %></div>
      </div>
      <div class="ics-stat-box">
        <div class="val"><%= number_to_currency(c.total_paid, unit: "₭", precision: 0, delimiter: ",") %></div>
        <div class="lbl">ຮັບຈ່າຍແລ້ວ</div>
      </div>
    </div>
  </div>

  <div class="ics-card">
    <div class="ics-card-hd">
      <div class="ics-card-hd-l"><i class="fas fa-info-circle"></i>ຂໍ້ມູນສັນຍາ</div>
    </div>
    <div class="ics-g2">
      <div>
        <div class="ics-lbl">ວັນເລີ່ມສັນຍາ</div>
        <div class="ics-val"><%= c.start_date.strftime('%d/%m/%Y') %></div>
      </div>
      <div>
        <div class="ics-lbl">ວັນສິ້ນສຸດສັນຍາ</div>
        <div class="ics-val <%= 'muted' unless c.end_date %>"><%= c.end_date&.strftime('%d/%m/%Y') || 'ບໍ່ມີກຳນົດ' %></div>
      </div>
      <div style="grid-column:1 / -1;">
        <div class="ics-lbl">ໝາຍເຫດ</div>
        <div class="ics-val <%= 'muted' unless c.notes.present? %>"><%= c.notes.presence || 'ບໍ່ມີ' %></div>
      </div>
    </div>
  </div>

  <div class="ics-card">
    <div class="ics-card-hd">
      <div class="ics-card-hd-l"><i class="fas fa-money-bill-wave"></i>ບັນທຶກການຊຳລະຄ່າເຊົ່າ</div>
    </div>

    <% unless current_admin_user.service_partner? %>
      <%= form_with url: add_payment_admin_service_center_contract_path(c), method: :post, local: true, html: { class: "pay-form" } do |f| %>
        <div class="pay-field">
          <label>ຈຳນວນ (₭)</label>
          <input type="number" name="amount" class="pay-input" placeholder="0" required style="width:140px;">
        </div>
        <div class="pay-field">
          <label>ວັນທີ່ຈ່າຍ</label>
          <input type="date" name="paid_at" class="pay-input" value="<%= Date.current %>" required>
        </div>
        <div class="pay-field">
          <label>ງວດ</label>
          <input type="text" name="period_label" class="pay-input" placeholder="ເຊັ່ນ: 05/2026" style="width:120px;">
        </div>
        <div class="pay-field">
          <label>ຊ່ອງທາງ</label>
          <select name="payment_method" class="pay-input" style="width:150px;">
            <option value="">— ບໍ່ລະບຸ —</option>
            <% ServiceCenterPayment::METHODS.each do |m| %>
              <option value="<%= m %>"><%= m %></option>
            <% end %>
          </select>
        </div>
        <div class="pay-field">
          <label>ສະຖານະ</label>
          <select name="status" class="pay-input" style="width:130px;">
            <option value="paid">ຈ່າຍແລ້ວ</option>
            <option value="pending">ຄ້າງຊຳລະ</option>
          </select>
        </div>
        <button type="submit" class="pay-btn"><i class="fas fa-plus"></i> ບັນທຶກ</button>
      <% end %>
    <% end %>

    <table class="ics-table">
      <thead>
        <tr><th>ວັນທີ່</th><th>ງວດ</th><th>ຊ່ອງທາງ</th><th style="text-align:right;">ຈຳນວນ</th><th>ສະຖານະ</th><th></th></tr>
      </thead>
      <tbody>
        <% if c.service_center_payments.empty? %>
          <tr><td colspan="6" style="text-align:center;color:#94a3b8;padding:20px;">ຍັງບໍ່ມີການບັນທຶກການຈ່າຍ</td></tr>
        <% else %>
          <% c.service_center_payments.order(paid_at: :desc).each do |p| %>
            <tr>
              <td><%= p.paid_at.strftime('%d/%m/%Y') %></td>
              <td><%= p.period_label.presence || "—" %></td>
              <td style="font-size:12px;color:var(--muted);"><%= p.payment_method.presence || "—" %></td>
              <td style="text-align:right;font-weight:700;color:#27bc9c;"><%= number_to_currency(p.amount, unit: "₭", precision: 0, delimiter: ",") %></td>
              <td>
                <% if p.status == "paid" %>
                  <span style="color:#16a34a;font-weight:700;font-size:12px;">ຈ່າຍແລ້ວ</span>
                <% else %>
                  <span style="color:#f59e0b;font-weight:700;font-size:12px;">ຄ້າງຊຳລະ</span>
                <% end %>
              </td>
              <td>
                <% if p.status == "pending" && !current_admin_user.service_partner? %>
                  <%= button_to mark_payment_paid_admin_service_center_contract_path(c, payment_id: p.id), method: :post, class: "pay-btn", style: "padding:4px 10px;font-size:11px;" do %>
                    ໝາຍວ່າຈ່າຍແລ້ວ
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
