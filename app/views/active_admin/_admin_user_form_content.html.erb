<% u = resource %>
<%
  role_meta = {
    "admin"      => { label: "Admin",      icon: "fa-user-shield",     desc: "ສິດເຕັມ ເຂົ້າເຖິງທຸກໜ້າ" },
    "superadmin" => { label: "Superadmin", icon: "fa-crown",           desc: "ສິດເຕັມ + ຈັດການ Role/ສິດທິ໌" },
    "partner"    => { label: "Partner",    icon: "fa-warehouse",       desc: "ສະເພາະສູນກວດກາຂອງຕົນເອງ" },
    "insurance"  => { label: "Insurance",  icon: "fa-building-shield", desc: "ສະເພາະບໍລິສັດປະກັນໄພຂອງຕົນເອງ" },
    "service_partner" => { label: "ພາດເນີສູນບໍລິການ", icon: "fa-store", desc: "ສະເພາະສູນສ້ອມແປງ/ຂາຍ/ລາກລົດຂອງຕົນເອງ" },
    "staff"      => { label: "Staff",      icon: "fa-id-badge",        desc: "ຕາມສິດທິ໌ໃນ Role ທີ່ກຳນົດ" },
  }
%>

<style>
  #titlebar { display:none !important; }
  body.active_admin, #wrapper, #active_admin_content, #main_content,
  #main, .flashes { background:#f4f6f9 !important; }
  #main_content > .panel { background:transparent !important; border:none !important; box-shadow:none !important; padding:0 !important; margin:0 !important; }
  #main_content > .panel > .panel_contents { padding:0 !important; }

  .vef-page {
    --brand:#27bc9c; --brand-d:#1e9e82; --ink:#1f2a37; --muted:#6b7684; --line:#e9edf2; --soft:#f4f6f9;
    color:var(--ink); font-family:"Noto Sans Lao","Phetsarath OT",system-ui,sans-serif;
    max-width:820px;
  }

  .vef-bar { display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom:28px; }
  .vef-bar-l { display:flex; align-items:center; gap:14px; }
  .vef-bar-ico { width:50px; height:50px; border-radius:14px; display:grid; place-items:center;
                 background:linear-gradient(135deg,#27bc9c,#1e9e82); color:#fff; font-size:20px;
                 box-shadow:0 8px 20px rgba(39,188,156,.35); flex-shrink:0; }
  .vef-bar h2 { font-size:21px; font-weight:800; margin:0; }
  .vef-bar p  { font-size:12.5px; color:var(--muted); margin:3px 0 0; }
  .vef-bar-btns { display:flex; gap:10px; }
  .vef-btn { display:inline-flex; align-items:center; gap:7px; padding:10px 22px; border-radius:11px;
             font-size:13.5px; font-weight:700; cursor:pointer; text-decoration:none !important;
             text-shadow:none !important; border:none; transition:.15s; white-space:nowrap;
             font-family:inherit; }
  .vef-btn-save { background:linear-gradient(135deg,#27bc9c,#1e9e82); color:#fff !important;
                  box-shadow:0 6px 16px rgba(39,188,156,.35); }
  .vef-btn-save:hover { filter:brightness(1.07); color:#fff !important; transform:translateY(-1px); }
  .vef-btn-back { background:#fff; border:1.5px solid var(--line); color:var(--muted) !important;
                  box-shadow:0 2px 8px rgba(0,0,0,.06); }
  .vef-btn-back:hover { border-color:#27bc9c; color:#27bc9c !important; }

  .vef-card { background:#fff; border-radius:20px; box-shadow:0 4px 20px rgba(16,24,40,.06);
              padding:28px 32px; margin-bottom:20px; }
  .vef-card-hd { display:flex; align-items:center; justify-content:space-between; gap:10px; font-size:15px; font-weight:800;
                 color:var(--ink); margin-bottom:24px; padding-bottom:14px;
                 border-bottom:2px solid var(--soft); }
  .vef-card-hd-l { display:flex; align-items:center; gap:10px; }
  .vef-card-hd i { width:32px; height:32px; border-radius:9px; display:grid; place-items:center;
                   background:#e6f7f3; color:#27bc9c; font-size:14px; flex-shrink:0; }

  .vef-g2 { display:grid; grid-template-columns:repeat(2,1fr); gap:20px; }

  .vef-field { display:flex; flex-direction:column; gap:6px; }
  .vef-label { font-size:12px; font-weight:700; color:#475569; letter-spacing:.02em; text-transform:uppercase; }
  .vef-label span { color:#ef4444; }
  .vef-input, .vef-page select {
    border:1.5px solid var(--line) !important; border-radius:10px !important;
    padding:11px 14px !important; font-size:13.5px !important; background:#fff !important;
    outline:none !important; font-family:inherit !important; color:var(--ink) !important;
    transition:.2s; width:100% !important; box-sizing:border-box !important;
    min-height:44px !important; line-height:1.4 !important; margin:0 !important;
    box-shadow:none !important; appearance:none; -webkit-appearance:none;
  }
  .vef-input:focus, .vef-page select:focus { border-color:#27bc9c !important; box-shadow:0 0 0 3px rgba(39,188,156,.13) !important; }
  .vef-input::placeholder { color:#b0bac5; }
  .vef-hint { font-size:11.5px; color:var(--muted); margin-top:2px; }

  .vef-errors { background:#fff1f2; border:1.5px solid #fca5a5; border-radius:14px;
                padding:16px 22px; margin-bottom:20px; }
  .vef-errors strong { color:#dc2626; display:block; margin-bottom:8px; }
  .vef-errors li { color:#dc2626; font-size:13px; margin-bottom:2px; }

  /* ── Role picker: card grid, radio-driven ── */
  .rf-role-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(150px,1fr)); gap:10px; }
  .rf-role-sr { display:none; }
  .rf-role-card { display:flex; flex-direction:column; align-items:center; gap:8px; text-align:center;
                  border:1.5px solid var(--line); border-radius:14px; padding:16px 10px; cursor:pointer;
                  transition:.15s; user-select:none; }
  .rf-role-card:hover { border-color:#a7e8da; background:#fbfffe; }
  .rf-role-card i { font-size:20px; color:#94a3b8; }
  .rf-role-card .rf-role-name { font-size:13px; font-weight:800; color:var(--ink); }
  .rf-role-card .rf-role-desc { font-size:10.5px; color:var(--muted); line-height:1.3; }
  .rf-role-sr:checked + .rf-role-card { border-color:#27bc9c; background:#f0fdfa; box-shadow:0 0 0 3px rgba(39,188,156,.12); }
  .rf-role-sr:checked + .rf-role-card i, .rf-role-sr:checked + .rf-role-card .rf-role-name { color:#0f766e; }

  .rf-conditional { display:none; margin-top:20px; padding-top:20px; border-top:1.5px dashed var(--line); }
  .rf-conditional.rf-visible { display:block; }

  .rf-toggle-row { display:flex; align-items:center; justify-content:space-between; gap:14px;
                    border:1.5px solid var(--line); border-radius:12px; padding:14px 18px; }
  .rf-toggle-row .rf-toggle-text { font-size:13px; font-weight:700; color:var(--ink); }
  .rf-toggle-row .rf-toggle-hint { font-size:11px; color:var(--muted); margin-top:2px; font-weight:400; }
  .rf-switch { position:relative; width:44px; height:24px; flex-shrink:0; }
  .rf-switch input { opacity:0; width:0; height:0; }
  .rf-switch-track { position:absolute; inset:0; background:#cbd5e1; border-radius:24px; cursor:pointer; transition:.2s; }
  .rf-switch-track:before { content:""; position:absolute; width:18px; height:18px; left:3px; top:3px;
                             background:#fff; border-radius:50%; transition:.2s; }
  .rf-switch input:checked + .rf-switch-track { background:#27bc9c; }
  .rf-switch input:checked + .rf-switch-track:before { transform:translateX(20px); }
</style>

<div class="vef-page">
  <%= form_with model: [:admin, u], local: true, html: { style:"margin:0;" } do |f| %>

    <div class="vef-bar">
      <div class="vef-bar-l">
        <div class="vef-bar-ico"><i class="fas fa-user-shield"></i></div>
        <div>
          <h2><%= u.persisted? ? 'ແກ້ໄຂຜູ້ດູແລລະບົບ' : 'ເພີ່ມຜູ້ດູແລລະບົບໃໝ່' %></h2>
          <p>ກຳນົດບົດບາດ ແລະ ຂອບເຂດການເຂົ້າເຖິງຂອງບັນຊີນີ້</p>
        </div>
      </div>
      <div class="vef-bar-btns">
        <%= f.submit(u.persisted? ? 'ບັນທຶກການແກ້ໄຂ' : 'ບັນທຶກທັງໝົດ', class: 'vef-btn vef-btn-save') %>
        <%= link_to admin_admin_users_path, class: 'vef-btn vef-btn-back' do %>
          <i class="fas fa-arrow-left"></i>ກັບຄືນ
        <% end %>
      </div>
    </div>

    <% if u.errors.any? %>
      <div class="vef-errors">
        <strong><i class="fas fa-exclamation-circle" style="margin-right:6px;"></i>ກະລຸນາກວດສອບຂໍ້ມູນ</strong>
        <ul style="margin:0;padding-left:18px;">
          <% u.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="vef-card">
      <div class="vef-card-hd">
        <div class="vef-card-hd-l"><i class="fas fa-key"></i>ຂໍ້ມູນເຂົ້າສູ່ລະບົບ</div>
      </div>

      <div class="vef-field" style="margin-bottom:20px;">
        <label class="vef-label">ອີເມວ <span>*</span></label>
        <%= f.email_field :email, class: 'vef-input', placeholder: 'name@motogate.com' %>
      </div>

      <div class="vef-g2">
        <div class="vef-field">
          <label class="vef-label">ລະຫັດຜ່ານ <%= '(ປະໄວ້ຫວ່າງຖ້າບໍ່ປ່ຽນ)' unless u.persisted? %></label>
          <%= f.password_field :password, class: 'vef-input', placeholder: '••••••••', autocomplete: 'new-password' %>
        </div>
        <div class="vef-field">
          <label class="vef-label">ຢືນຢັນລະຫັດຜ່ານ</label>
          <%= f.password_field :password_confirmation, class: 'vef-input', placeholder: '••••••••', autocomplete: 'new-password' %>
        </div>
      </div>
    </div>

    <div class="vef-card">
      <div class="vef-card-hd">
        <div class="vef-card-hd-l"><i class="fas fa-sitemap"></i>ບົດບາດ ແລະ ຂອບເຂດການເຂົ້າເຖິງ</div>
      </div>

      <div class="rf-role-grid">
        <% role_meta.each do |key, meta| %>
          <%= f.radio_button :role, key, id: "role_#{key}", class: 'rf-role-sr', checked: (u.role.presence || 'admin') == key %>
          <label class="rf-role-card" for="role_<%= key %>">
            <i class="fas <%= meta[:icon] %>"></i>
            <span class="rf-role-name"><%= meta[:label] %></span>
            <span class="rf-role-desc"><%= meta[:desc] %></span>
          </label>
        <% end %>
      </div>

      <div class="rf-conditional" data-role-for="partner">
        <div class="vef-field">
          <label class="vef-label">ສູນກວດກາເຕັກນິກ <span>*</span></label>
          <%= f.select :inspection_center_id,
                options_from_collection_for_select(InspectionCenter.order(:name), :id, :name, u.inspection_center_id),
                { include_blank: '— ເລືອກສູນກວດກາ —' } %>
        </div>
      </div>

      <div class="rf-conditional" data-role-for="insurance">
        <div class="vef-field">
          <label class="vef-label">ບໍລິສັດປະກັນໄພ <span>*</span></label>
          <%= f.select :insurance_company_id,
                options_from_collection_for_select(InsuranceCompany.order(:name), :id, :name, u.insurance_company_id),
                { include_blank: '— ເລືອກບໍລິສັດ —' } %>
        </div>
      </div>

      <div class="rf-conditional" data-role-for="service_partner">
        <div class="vef-field">
          <label class="vef-label">ສູນບໍລິການ <span>*</span></label>
          <%= f.select :service_center_id,
                options_from_collection_for_select(ServiceCenter.order(:name), :id, ->(sc) { "#{sc.name} (#{ { 'garage' => 'ສ້ອມແປງ', 'dealer' => 'ຂາຍລົດ', 'towing' => 'ລາກລົດ' }[sc.service_type] })" }, u.service_center_id),
                { include_blank: '— ເລືອກສູນບໍລິການ —' } %>
        </div>
      </div>

      <div class="rf-conditional" data-role-for="staff">
        <div class="vef-field">
          <label class="vef-label">Role (ສິດທິ໌) <span>*</span></label>
          <%= f.select :custom_role_id,
                options_from_collection_for_select(Role.order(:name), :id, :name, u.custom_role_id),
                { include_blank: '— ເລືອກ Role —' } %>
          <p class="vef-hint">
            ຈັດການ Role ແລະ ສິດທິ໌ໄດ້ທີ່ <%= link_to "ໜ້າຈັດການສິດທິ໌", admin_roles_path %>
          </p>
        </div>
      </div>

      <div class="rf-conditional" data-role-for="admin,superadmin" style="margin-top:20px;">
        <div class="rf-toggle-row">
          <div>
            <div class="rf-toggle-text">Support Agent</div>
            <div class="rf-toggle-hint">ຮັບເຄສ Support ແບບໝູນວຽນອັດຕະໂນມັດ (ຕ້ອງອອນລາຍຢູ່ນຳ)</div>
          </div>
          <label class="rf-switch">
            <%= f.check_box :is_support_agent %>
            <span class="rf-switch-track"></span>
          </label>
        </div>
      </div>
    </div>

  <% end %>
</div>

<script>
  (function () {
    var radios = document.querySelectorAll('.rf-role-sr');
    var conditionals = document.querySelectorAll('.rf-conditional');

    function sync() {
      var current = document.querySelector('.rf-role-sr:checked');
      var role = current ? current.value : null;
      conditionals.forEach(function (block) {
        var roles = block.dataset.roleFor.split(',');
        block.classList.toggle('rf-visible', role && roles.indexOf(role) !== -1);
      });
    }

    radios.forEach(function (r) { r.addEventListener('change', sync); });
    sync();
  })();
</script>
