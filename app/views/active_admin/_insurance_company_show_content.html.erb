<style>
  #titlebar { display:none !important; }
  body.active_admin, #wrapper, #active_admin_content, #main_content,
  #main, .flashes { background:#f4f6f9 !important; }
  #main_content > .panel { background:transparent !important; border:none !important; box-shadow:none !important; padding:0 !important; margin:0 !important; }
  #main_content > .panel > .panel_contents { padding:0 !important; }

  .ics-page {
    --brand:#27bc9c; --brand-d:#1e9e82; --ink:#1f2a37; --muted:#6b7684; --line:#e9edf2; --soft:#f4f6f9;
    color:var(--ink); font-family:"Noto Sans Lao","Phetsarath OT",system-ui,sans-serif;
    max-width:1280px;
  }

  .ics-bar { display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom:22px; }
  .ics-bar-l { display:flex; align-items:center; gap:14px; }
  .ics-bar-ico { width:50px; height:50px; border-radius:14px; display:grid; place-items:center;
                 background:linear-gradient(135deg,#27bc9c,#1e9e82); color:#fff; font-size:20px;
                 box-shadow:0 8px 20px rgba(39,188,156,.35); flex-shrink:0; }
  .ics-bar h2 { font-size:21px; font-weight:800; margin:0; }
  .ics-bar p  { font-size:12.5px; color:var(--muted); margin:3px 0 0; }
  .ics-bar-btns { display:flex; gap:10px; }
  .ics-btn { display:inline-flex; align-items:center; gap:7px; padding:10px 20px; border-radius:11px;
             font-size:13.5px; font-weight:700; cursor:pointer; text-decoration:none !important;
             text-shadow:none !important; border:none; transition:.15s; white-space:nowrap;
             font-family:inherit; }
  .ics-btn-edit { background:linear-gradient(135deg,#27bc9c,#1e9e82); color:#fff !important;
                  box-shadow:0 6px 16px rgba(39,188,156,.35); }
  .ics-btn-edit:hover { filter:brightness(1.07); color:#fff !important; transform:translateY(-1px); }
  .ics-btn-back { background:#fff; border:1.5px solid var(--line); color:var(--muted) !important;
                  box-shadow:0 2px 8px rgba(0,0,0,.06); }
  .ics-btn-back:hover { border-color:#27bc9c; color:#27bc9c !important; }

  /* ── Hero ── */
  .ics-hero { background:#fff; border-radius:20px; box-shadow:0 4px 20px rgba(16,24,40,.06);
              padding:26px 28px; margin-bottom:20px; display:flex; align-items:center; gap:24px; flex-wrap:wrap; }
  .ics-logo { width:84px; height:84px; border-radius:20px; background:#f8f9fa; border:1.5px solid var(--line);
              display:flex; align-items:center; justify-content:center; overflow:hidden; flex-shrink:0; }
  .ics-logo img { width:100%; height:100%; object-fit:contain; }
  .ics-logo i { font-size:32px; color:#c2cad4; }
  .ics-hero-info { flex:1; min-width:200px; }
  .ics-hero-info h3 { font-size:19px; font-weight:800; margin:0 0 8px; }
  .ics-hero-meta { display:flex; align-items:center; gap:14px; flex-wrap:wrap; font-size:12.5px; color:var(--muted); }
  .ics-hero-meta span { display:inline-flex; align-items:center; gap:6px; }
  .ics-status { display:inline-flex; align-items:center; gap:5px; padding:5px 12px; border-radius:20px; font-size:12px; font-weight:700; }
  .ics-status-active   { background:#dcfce7; color:#16a34a; }
  .ics-status-inactive { background:#fee2e2; color:#dc2626; }
  .ics-hero-stats { display:flex; gap:12px; flex-shrink:0; }
  .ics-stat-box { text-align:center; background:var(--soft); border-radius:14px; padding:12px 20px; min-width:84px; }
  .ics-stat-box .val { font-size:22px; font-weight:800; color:var(--brand-d); letter-spacing:-.5px; }
  .ics-stat-box .lbl { font-size:11px; color:var(--muted); font-weight:600; margin-top:2px; }

  /* ── Layout ── */
  .ics-layout { display:grid; grid-template-columns:5fr 7fr; gap:20px; align-items:start; }
  @media (max-width:900px) { .ics-layout { grid-template-columns:1fr; } }

  .ics-card { background:#fff; border-radius:20px; box-shadow:0 4px 20px rgba(16,24,40,.06);
              padding:24px 26px; margin-bottom:20px; }
  .ics-card-hd { display:flex; align-items:center; justify-content:space-between; gap:10px; font-size:15px; font-weight:800;
                 color:var(--ink); margin-bottom:18px; padding-bottom:14px; border-bottom:2px solid var(--soft); }
  .ics-card-hd-l { display:flex; align-items:center; gap:10px; }
  .ics-card-hd i { width:32px; height:32px; border-radius:9px; display:grid; place-items:center;
                   background:#e6f7f3; color:#27bc9c; font-size:14px; flex-shrink:0; }
  .ics-pkg-count { font-size:11.5px; font-weight:700; color:var(--muted); background:var(--soft);
                    padding:4px 12px; border-radius:20px; }

  .ics-field { margin-bottom:16px; }
  .ics-field:last-child { margin-bottom:0; }
  .ics-lbl { font-size:11px; font-weight:700; color:var(--muted); text-transform:uppercase; letter-spacing:.4px; margin-bottom:4px; }
  .ics-val { font-size:14px; color:var(--ink); }
  .ics-val.muted { color:#b0bac5; font-style:italic; }
  .ics-meta-row { display:flex; justify-content:space-between; font-size:12px; color:var(--muted); padding:8px 0; border-top:1px solid var(--soft); }

  .ics-pkg-empty { text-align:center; padding:36px 16px; color:var(--muted); font-size:13px; }

  .ics-pkg-card { border:1.5px solid var(--line); border-radius:16px; padding:18px 20px; margin-bottom:14px; background:#fbfcfd; }
  .ics-pkg-card:last-child { margin-bottom:0; }
  .ics-pkg-card.incomplete { border-color:#fbbf24; background:#fffbeb; }
  .ics-pkg-hd { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:14px; }
  .ics-pkg-name { font-size:14.5px; font-weight:800; }
  .ics-pkg-grid { display:grid; grid-template-columns:repeat(auto-fit, minmax(120px, 1fr)); gap:14px; }
  .ics-pkg-field-lbl { font-size:10.5px; font-weight:700; color:var(--muted); text-transform:uppercase; letter-spacing:.3px; margin-bottom:4px; }
  .ics-pkg-field-val { font-size:13.5px; font-weight:600; }
  .ics-pkg-field-val.price { color:var(--brand-d); font-size:15px; font-weight:800; }
  .ics-pkg-warn { margin-top:12px; display:flex; align-items:center; gap:8px; background:#fef3c7; color:#92400e;
                  border-radius:10px; padding:8px 12px; font-size:12px; font-weight:600; }
</style>

<div class="ics-page">

  <div class="ics-bar">
    <div class="ics-bar-l">
      <div class="ics-bar-ico"><i class="fas fa-building"></i></div>
      <div>
        <h2>ລາຍລະອຽດບໍລິສັດປະກັນໄພ</h2>
        <p><%= company.name %></p>
      </div>
    </div>
    <div class="ics-bar-btns">
      <%= link_to edit_admin_insurance_company_path(company), class: 'ics-btn ics-btn-edit' do %>
        <i class="fas fa-edit"></i>ແກ້ໄຂ
      <% end %>
      <%= link_to admin_insurance_companies_path, class: 'ics-btn ics-btn-back' do %>
        <i class="fas fa-arrow-left"></i>ກັບຄືນ
      <% end %>
    </div>
  </div>

  <div class="ics-hero">
    <div class="ics-logo">
      <% if company.logo.present? %>
        <img src="<%= company.logo %>" alt="logo">
      <% else %>
        <i class="fas fa-building"></i>
      <% end %>
    </div>
    <div class="ics-hero-info">
      <h3><%= company.name %></h3>
      <div class="ics-hero-meta">
        <span class="ics-status <%= company.status == 'active' ? 'ics-status-active' : 'ics-status-inactive' %>">
          <i class="fas <%= company.status == 'active' ? 'fa-check-circle' : 'fa-times-circle' %>"></i>
          <%= company.status == 'active' ? 'ເປີດໃຊ້ງານ' : 'ປິດໃຊ້ງານ' %>
        </span>
        <span><i class="fas fa-phone"></i><%= company.phone.presence || '—' %></span>
        <span><i class="fas fa-envelope"></i><%= company.email.presence || '—' %></span>
        <span><i class="fas fa-calendar"></i>ເພີ່ມເມື່ອ <%= company.created_at.strftime('%d/%m/%Y') %></span>
      </div>
    </div>
    <div class="ics-hero-stats">
      <div class="ics-stat-box">
        <div class="val"><%= company.insurance_packages.size %></div>
        <div class="lbl">ແພັກເກັດ</div>
      </div>
      <div class="ics-stat-box">
        <div class="val"><%= company.insurance_packages.count { |p| p.status == 'active' } %></div>
        <div class="lbl">ເປີດໃຊ້ງານ</div>
      </div>
    </div>
  </div>

  <div class="ics-layout">
    <%# ── Left: company info ── %>
    <div>
      <div class="ics-card">
        <div class="ics-card-hd">
          <div class="ics-card-hd-l"><i class="fas fa-address-card"></i>ຂໍ້ມູນຕິດຕໍ່</div>
        </div>
        <div class="ics-field">
          <div class="ics-lbl">ເບີໂທ</div>
          <div class="ics-val <%= 'muted' unless company.phone.present? %>"><%= company.phone.presence || 'ບໍ່ໄດ້ລະບຸ' %></div>
        </div>
        <div class="ics-field">
          <div class="ics-lbl">ອີເມວ</div>
          <div class="ics-val <%= 'muted' unless company.email.present? %>"><%= company.email.presence || 'ບໍ່ໄດ້ລະບຸ' %></div>
        </div>
      </div>

      <div class="ics-card">
        <div class="ics-card-hd">
          <div class="ics-card-hd-l"><i class="fas fa-file-alt"></i>ລາຍລະອຽດບໍລິສັດ</div>
        </div>
        <div class="ics-val <%= 'muted' unless company.description.present? %>">
          <%= company.description.presence || 'ບໍ່ໄດ້ລະບຸລາຍລະອຽດ' %>
        </div>
        <div class="ics-meta-row">
          <span>ສ້າງເມື່ອ</span>
          <span><%= company.created_at.strftime('%d/%m/%Y %H:%M') %></span>
        </div>
        <div class="ics-meta-row">
          <span>ອັບເດດລ່າສຸດ</span>
          <span><%= company.updated_at.strftime('%d/%m/%Y %H:%M') %></span>
        </div>
      </div>
    </div>

    <%# ── Right: packages ── %>
    <div class="ics-card">
      <div class="ics-card-hd">
        <div class="ics-card-hd-l"><i class="fas fa-box-open"></i>ແພັກເກັດ ປະກັນໄພ</div>
        <span class="ics-pkg-count"><%= company.insurance_packages.size %> ແພັກເກັດ</span>
      </div>

      <% if company.insurance_packages.empty? %>
        <p class="ics-pkg-empty">ຍັງບໍ່ມີແພັກເກັດ</p>
      <% else %>
        <% company.insurance_packages.each do |p| %>
          <% incomplete = p.vehicle_type.blank? || p.duration_months.blank? %>
          <div class="ics-pkg-card <%= 'incomplete' if incomplete %>">
            <div class="ics-pkg-hd">
              <div class="ics-pkg-name"><%= p.name.presence || 'ບໍ່ມີຊື່' %></div>
              <span class="ics-status <%= p.status == 'active' ? 'ics-status-active' : 'ics-status-inactive' %>">
                <i class="fas <%= p.status == 'active' ? 'fa-check-circle' : 'fa-times-circle' %>"></i>
                <%= p.status == 'active' ? 'ເປີດໃຊ້ງານ' : 'ປິດໃຊ້ງານ' %>
              </span>
            </div>
            <div class="ics-pkg-grid">
              <div>
                <div class="ics-pkg-field-lbl">ປະເພດ</div>
                <div class="ics-pkg-field-val"><%= p.vehicle_type.presence || '—' %></div>
              </div>
              <div>
                <div class="ics-pkg-field-lbl">ຂອບເຂດ</div>
                <div class="ics-pkg-field-val">
                  <% if InsurancePackage::SEAT_BASED_TYPES.include?(p.vehicle_type) %>
                    <%= p.min_seats || '—' %> - <%= p.max_seats || '—' %> ບ່ອນນັ່ງ
                  <% elsif InsurancePackage::WEIGHT_BASED_TYPES.include?(p.vehicle_type) %>
                    <%= p.min_weight || '—' %> - <%= p.max_weight || '—' %> ຕັນ
                  <% else %>
                    <%= p.min_cc || '—' %> - <%= p.max_cc || '—' %> CC
                  <% end %>
                </div>
              </div>
              <div>
                <div class="ics-pkg-field-lbl">ການນຳໃຊ້</div>
                <div class="ics-pkg-field-val"><%= p.usage_type.presence || 'ທຸກປະເພດ' %></div>
              </div>
              <div>
                <div class="ics-pkg-field-lbl">ລາຄາ</div>
                <div class="ics-pkg-field-val price"><%= number_to_currency(p.price, unit: "₭", precision: 0, delimiter: ",") %></div>
              </div>
              <div>
                <div class="ics-pkg-field-lbl">ໄລຍະ</div>
                <div class="ics-pkg-field-val"><%= p.duration_months.presence || '—' %> ເດືອນ</div>
              </div>
            </div>
            <% if incomplete %>
              <div class="ics-pkg-warn">
                <i class="fas fa-triangle-exclamation"></i>
                ຂໍ້ມູນບໍ່ຄົບ —
                <% if p.vehicle_type.blank? %>ຍັງບໍ່ໄດ້ລະບຸປະເພດລົດ<% end %>
                <% if p.vehicle_type.blank? && p.duration_months.blank? %> ແລະ <% end %>
                <% if p.duration_months.blank? %>ຍັງບໍ່ໄດ້ລະບຸໄລຍະເວລາ<% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>

</div>
