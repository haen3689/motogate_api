        bellBadge = document.createElement('span');
        bellBadge.className = 'hdr-badge';
        bellBadge.textContent = '1';
        notifBtn.appendChild(bellBadge);
      }
      if (notifBtn) {
        notifBtn.classList.remove('bell-ring');
        void notifBtn.offsetWidth;
        notifBtn.classList.add('bell-ring');
        setTimeout(function () { notifBtn.classList.remove('bell-ring'); }, 700);
      }
      var empty = document.getElementById('notif-empty');
      if (empty) empty.style.display = 'none';

      var container = document.getElementById('hdr-live-updates');
      if (container) {
        var a = document.createElement('a');
        a.href = '/admin/road_taxes/' + t.id;
        a.className = 'hdr-dd-item';
        a.innerHTML = '<div class="hdr-dd-ico primary"><i class="fas fa-road"></i></div>' +
          '<div style="flex:1;"><div class="hdr-dd-title">ຈ່າຍຄ່າທາງ ' + (t.plate_number || '-') + '</div>' +
          '<div class="hdr-dd-sub">ປີ ' + (t.tax_year || '') + ' — ກົດເພື່ອເບິ່ງ</div></div>' +
          '<i class="fas fa-chevron-right" style="font-size:.6rem;opacity:.4;"></i>';
        container.prepend(a);
