<%
  status_label = {
    'pending' => 'ລໍຖ້າຢືນຢັນ', 'confirmed' => 'ຢືນຢັນແລ້ວ',
    'completed' => 'ສຳເລັດແລ້ວ', 'cancelled' => 'ຍົກເລີກ'
  }
  status_class = {
    'pending' => 'ibk-status-pending', 'confirmed' => 'ibk-status-confirmed',
    'completed' => 'ibk-status-completed', 'cancelled' => 'ibk-status-cancelled'
  }

  filter_search = params.dig(:q, :search)
  filter_status = params.dig(:q, :status)
  filter_date   = params.dig(:q, :date)

  # Partner-role admin_users only ever see their own center's bookings —
  # the custom partials here query Inspection directly rather than going
  # through ActiveAdmin's scoped_collection, so this filter has to be
  # applied by hand at every entry point (index/show/form all do this).
  center_scope = current_admin_user.partner? ? Inspection.where(inspection_center_id: current_admin_user.inspection_center_id) : Inspection.all

  scope = center_scope.joins(vehicle: :user).includes(vehicle: :user).order(created_at: :desc)
  if filter_search.present?
    scope = scope.where(
      "vehicles.plate_number ILIKE :q OR inspections.center_name ILIKE :q OR inspections.service_name ILIKE :q OR users.phone_number ILIKE :q",
      q: "%#{filter_search.strip}%"
    )
  end
  scope = scope.where(status: filter_status) if filter_status.present?
  scope = scope.where("DATE(inspections.appointment_at) = ?", filter_date) if filter_date.present?

  page     = (params[:page] || 1).to_i
  per_page = 20
  bookings = scope.page(page).per(per_page)

  total           = center_scope.count
  pending_count   = center_scope.where(status: 'pending').count
  confirmed_count = center_scope.where(status: 'confirmed').count
  completed_count = center_scope.where(status: 'completed').count
  has_filter      = filter_search.present? || filter_status.present? || filter_date.present?
%>

<style>
  .index_content .scopes, #titlebar { display:none !important; }
  body.active_admin, #wrapper, #active_admin_content, #main_content,
  .index_content, #main, .flashes { background:#f4f6f9 !important; }
  .index_content > .panel,
  .index_as_content,
  #main_content .panel:first-child { background:transparent !important; border:none !important; box-shadow:none !important; padding:0 !important; margin:0 !important; }
  .index_content > .panel > .panel_contents,
  .index_as_content > .panel_contents { padding:0 !important; background:transparent !important; }

  .ibk-page { --brand:#27bc9c; --brand-d:#1e9e82; --ink:#1f2a37; --muted:#6b7684; --line:#e9edf2;
             color:var(--ink); font-family:"Noto Sans Lao","Phetsarath OT",system-ui,sans-serif; }

  .ibk-head { display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom:24px; }
  .ibk-head-l { display:flex; align-items:center; gap:14px; }
  .ibk-head-ico { width:48px; height:48px; border-radius:14px; display:grid; place-items:center;
                 color:#fff; font-size:20px; background:linear-gradient(135deg,#27bc9c,#1e9e82);
                 box-shadow:0 8px 18px rgba(39,188,156,.35); flex-shrink:0; }
  .ibk-head h2 { font-size:20px; font-weight:800; margin:0; letter-spacing:-.2px; }
  .ibk-head p  { font-size:12.5px; color:var(--muted); margin:3px 0 0; }

  .ibk-stats { display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-bottom:22px; }
  .ibk-stat { background:#fff; border-radius:16px; padding:18px 20px;
             box-shadow:0 4px 16px rgba(16,24,40,.05); display:flex; align-items:center; gap:16px;
             border-left:4px solid transparent; }
  .ibk-stat.teal  { border-left-color:#27bc9c; }
  .ibk-stat.amber { border-left-color:#f59e0b; }
  .ibk-stat.blue  { border-left-color:#2563eb; }
  .ibk-stat.green { border-left-color:#16a34a; }
  .ibk-stat-ico { width:44px; height:44px; border-radius:12px; display:grid; place-items:center; font-size:18px; flex-shrink:0; }
  .ibk-stat.teal  .ibk-stat-ico { background:#e6f7f3; color:#27bc9c; }
  .ibk-stat.amber .ibk-stat-ico { background:#fef3c7; color:#f59e0b; }
  .ibk-stat.blue  .ibk-stat-ico { background:#dbeafe; color:#2563eb; }
  .ibk-stat.green .ibk-stat-ico { background:#dcfce7; color:#16a34a; }
  .ibk-stat-label { font-size:12px; color:var(--muted); font-weight:600; margin:0 0 4px; }
  .ibk-stat-val   { font-size:24px; font-weight:800; margin:0; letter-spacing:-.5px; }

  .ibk-filter { background:#fff; border-radius:16px; padding:18px 20px; margin-bottom:20px;
               box-shadow:0 4px 16px rgba(16,24,40,.05); }
  .ibk-filter-label { display:block; font-size:12.5px; font-weight:700; color:#334155; margin-bottom:6px; }
  .ibk-filter-input { width:100%; border:1px solid var(--line); border-radius:10px; padding:10px 14px;
                     font-size:13.5px; background:#fff; outline:none;
                     font-family:inherit; color:var(--ink); box-sizing:border-box; min-height:44px; }
  .ibk-filter-input:focus { border-color:#27bc9c; box-shadow:0 0 0 3px rgba(39,188,156,.12); }
  .ibk-filter-row { display:flex !important; flex-direction:row !important; gap:12px; align-items:flex-end; flex-wrap:nowrap; }
  .ibk-filter-search { flex:2.2; min-width:0; }
  .ibk-filter-sel    { flex:1.3; min-width:0; }
  .ibk-filter-date   { flex:1.3; min-width:0; }
  .ibk-filter-btns   { flex-shrink:0; display:flex; flex-direction:column; gap:6px; }
  .ibk-btn-filter { border:none; border-radius:10px; padding:10px 18px; font-size:13.5px; font-weight:700;
                   background:#1f2a37; color:#fff; cursor:pointer; display:inline-flex; align-items:center; gap:6px;
                   white-space:nowrap; width:100%; justify-content:center; min-height:44px; box-sizing:border-box; }
  .ibk-btn-filter:hover { background:#374151; }
  .ibk-btn-clear { border:1px solid var(--line); border-radius:10px; padding:10px 18px; font-size:13.5px;
                  font-weight:600; background:#fff; text-decoration:none !important;
                  display:inline-flex; align-items:center; gap:6px; white-space:nowrap;
                  width:100%; justify-content:center; color:var(--muted) !important;
                  min-height:44px; box-sizing:border-box; }
  .ibk-btn-clear:hover { background:#f8fafc; color:var(--ink) !important; }

  .ibk-table-card { background:#fff; border-radius:20px; overflow:hidden; box-shadow:0 4px 20px rgba(16,24,40,.06); }
  .ibk-table { width:100%; border-collapse:collapse; }
  .ibk-table thead th { background:#f8fafc; padding:12px 14px; font-size:12px; font-weight:700;
                       color:var(--muted); text-transform:uppercase; letter-spacing:.5px;
                       border-bottom:1px solid var(--line); white-space:nowrap; }
  .ibk-table thead th:first-child { padding-left:20px; }
  .ibk-table thead th:last-child  { padding-right:20px; text-align:center; }
  .ibk-table tbody td { padding:12px 14px; font-size:13.5px; border-bottom:1px solid var(--line); vertical-align:middle; }
  .ibk-table tbody td:first-child { padding-left:20px; }
  .ibk-table tbody td:last-child  { padding-right:20px; text-align:center; }
  .ibk-table tbody tr:last-child td { border-bottom:none; }
  .ibk-table tbody tr:hover td { background:#fafcfb; }

  .ibk-status { display:inline-block; padding:5px 12px; border-radius:20px; font-size:12px; font-weight:600; white-space:nowrap; }
  .ibk-status-pending   { background:#fef3c7; color:#b45309; }
  .ibk-status-confirmed { background:#dbeafe; color:#1d4ed8; }
  .ibk-status-completed { background:#dcfce7; color:#16a34a; }
  .ibk-status-cancelled { background:#fee2e2; color:#dc2626; }

  .ibk-actions { display:flex; gap:5px; justify-content:center; }
  .ibk-btn-view { border:1px solid #0ea5e9; background:#f0f9ff; color:#0369a1 !important; border-radius:7px;
                 padding:5px 10px; font-size:12px; font-weight:700; text-decoration:none !important;
                 display:inline-flex; align-items:center; gap:4px; transition:.15s; }
  .ibk-btn-view:hover { background:#0ea5e9; color:#fff !important; }
  .ibk-btn-edit { border:1px solid #16a34a; background:#f0fdf4; color:#15803d !important; border-radius:7px;
                 padding:5px 10px; font-size:12px; font-weight:700; text-decoration:none !important;
                 display:inline-flex; align-items:center; gap:4px; transition:.15s; }
  .ibk-btn-edit:hover { background:#16a34a; color:#fff !important; }
  .ibk-btn-del { border:1px solid #f87171; background:#fff1f2; color:#991b1b; border-radius:7px;
                padding:5px 10px; font-size:12px; font-weight:700; cursor:pointer;
                display:inline-flex; align-items:center; gap:4px; transition:.15s; }
  .ibk-btn-del:hover { background:#dc2626; color:#fff; border-color:#dc2626; }
  .ibk-btn-del form { margin:0; }

  .ibk-empty { text-align:center; padding:60px 20px; }
  .ibk-empty i { font-size:3rem; color:#cbd5e1; display:block; margin-bottom:12px; }
  .ibk-empty p { color:var(--muted); font-size:14px; margin:0; }

  .ibk-page-wrap .pagination .page.current a,
  .ibk-page-wrap .pagination .page.current span { background:#27bc9c; border-color:#27bc9c; color:#fff; border-radius:8px; }
  .ibk-page-wrap .pagination a, .ibk-page-wrap .pagination span { border-radius:8px; }

  /* Plate badge — same fixed-size component as the vehicles list, so a
     plate looks identical wherever it's shown across the admin. */
  .plate-badge { border:2px solid #333; border-radius:8px; padding:8px 10px; display:inline-flex;
                 flex-direction:column; justify-content:center; align-items:center;
                 width:90px; height:45px; box-sizing:border-box;
                 text-align:center; overflow:hidden; box-shadow:0 2px 4px rgba(0,0,0,.1); }
  .plate-province { font-size:9px; font-weight:700; line-height:1; text-transform:uppercase;
                     white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:100%; }
  .plate-number   { font-size:15px; font-weight:900; line-height:1.2; letter-spacing:1px;
                     white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:100%; }
  .plate-badge.plate-yellow        { background:linear-gradient(135deg,#ffcc00,#ffdb4d); border-color:#333; }
  .plate-badge.plate-yellow        .plate-province, .plate-badge.plate-yellow        .plate-number { color:#000; }
  .plate-badge.plate-yellow-green  { background:linear-gradient(135deg,#ffcc00,#ffdb4d); border-color:#333; }
  .plate-badge.plate-yellow-green  .plate-province { color:#000; }
  .plate-badge.plate-yellow-green  .plate-number   { color:#16a34a; }
  .plate-badge.plate-yellow-blue   { background:linear-gradient(135deg,#ffcc00,#ffdb4d); border-color:#3b82f6; }
  .plate-badge.plate-yellow-blue   .plate-province, .plate-badge.plate-yellow-blue .plate-number { color:#3b82f6; }
  .plate-badge.plate-blue          { background:linear-gradient(135deg,#1e3a8a,#1e3a8a); border-color:#1e3a8a; }
  .plate-badge.plate-blue          .plate-province, .plate-badge.plate-blue          .plate-number { color:#fff; }
  .plate-badge.plate-white         { background:linear-gradient(135deg,#fff,#f5f5f5); border-color:#333; }
  .plate-badge.plate-white         .plate-province, .plate-badge.plate-white         .plate-number { color:#000; }
  .plate-badge.plate-white-darkblue  { background:linear-gradient(135deg,#fff,#f5f5f5); border-color:#1e3a8a; }
  .plate-badge.plate-white-darkblue  .plate-province, .plate-badge.plate-white-darkblue .plate-number { color:#1e3a8a; }
  .plate-badge.plate-white-lightblue { background:linear-gradient(135deg,#fff,#f5f5f5); border-color:#60a5fa; }
  .plate-badge.plate-white-lightblue .plate-province, .plate-badge.plate-white-lightblue .plate-number { color:#60a5fa; }
  .plate-badge.plate-red           { background:linear-gradient(135deg,#dc2626,#b91c1c); border-color:#7f1d1d; }
  .plate-badge.plate-red           .plate-province, .plate-badge.plate-red           .plate-number { color:#fff; }
  .plate-badge.plate-red-underline { background:linear-gradient(135deg,#dc2626,#b91c1c); border-color:#7f1d1d; }
  .plate-badge.plate-red-underline .plate-province, .plate-badge.plate-red-underline .plate-number { color:#fff; }
  .plate-badge.plate-white-1percent { background:linear-gradient(135deg,#fff,#f5f5f5); border:3px solid #2563eb; }
  .plate-badge.plate-white-1percent .plate-province, .plate-badge.plate-white-1percent .plate-number { color:#2563eb; }
  .plate-badge.plate-white-foreign { background:linear-gradient(135deg,#fff,#f5f5f5); border-color:#2563eb; }
  .plate-badge.plate-white-foreign .plate-province, .plate-badge.plate-white-foreign .plate-number { color:#2563eb; }
  .plate-badge.plate-diplomat      { background:linear-gradient(135deg,#fff,#f5f5f5); border:2px solid #2563eb; }
  .plate-badge.plate-diplomat      .plate-province, .plate-badge.plate-diplomat .plate-number { color:#2563eb; }
</style>

<div class="ibk-page">

  <div class="ibk-head">
    <div class="ibk-head-l">
      <div class="ibk-head-ico"><i class="fas fa-clipboard-check"></i></div>
      <div>
        <h2>ລາຍການຈອງກວດສະພາບລົດ</h2>
        <p>ຕິດຕາມຄິວການຈອງກວດສະພາບລົດຈາກລູກຄ້າຜ່ານແອັບ</p>
      </div>
    </div>
  </div>

  <div class="ibk-stats">
    <div class="ibk-stat teal">
      <div class="ibk-stat-ico"><i class="fas fa-calendar-check"></i></div>
      <div>
        <p class="ibk-stat-label">ການຈອງທັງໝົດ</p>
        <p class="ibk-stat-val"><%= number_with_delimiter(total) %></p>
      </div>
    </div>
    <div class="ibk-stat amber">
      <div class="ibk-stat-ico"><i class="fas fa-hourglass-half"></i></div>
      <div>
        <p class="ibk-stat-label">ລໍຖ້າຢືນຢັນ</p>
        <p class="ibk-stat-val"><%= number_with_delimiter(pending_count) %></p>
      </div>
    </div>
    <div class="ibk-stat blue">
      <div class="ibk-stat-ico"><i class="fas fa-check"></i></div>
      <div>
        <p class="ibk-stat-label">ຢືນຢັນແລ້ວ</p>
        <p class="ibk-stat-val"><%= number_with_delimiter(confirmed_count) %></p>
      </div>
    </div>
    <div class="ibk-stat green">
      <div class="ibk-stat-ico"><i class="fas fa-flag-checkered"></i></div>
      <div>
        <p class="ibk-stat-label">ສຳເລັດແລ້ວ</p>
        <p class="ibk-stat-val"><%= number_with_delimiter(completed_count) %></p>
      </div>
    </div>
  </div>

  <div class="ibk-filter">
    <form method="GET" action="<%= admin_inspections_path %>">
      <div class="ibk-filter-row">
        <div class="ibk-filter-search">
          <label class="ibk-filter-label">ຄົ້ນຫາ</label>
          <input type="text" name="q[search]" class="ibk-filter-input"
                 value="<%= filter_search %>" placeholder="ທະບຽນລົດ, ສູນກວດກາ, ບໍລິການ, ເບີໂທ...">
        </div>
        <div class="ibk-filter-sel">
          <label class="ibk-filter-label">ສະຖານະ</label>
          <select name="q[status]" class="ibk-filter-input">
            <option value="">ທັງໝົດ</option>
            <% Inspection::STATUSES.each do |s| %>
              <option value="<%= s %>" <%= 'selected' if filter_status == s %>><%= status_label[s] %></option>
            <% end %>
          </select>
        </div>
        <div class="ibk-filter-date">
          <label class="ibk-filter-label">ວັນນັດໝາຍ</label>
          <input type="date" name="q[date]" class="ibk-filter-input" value="<%= filter_date %>">
        </div>
        <div class="ibk-filter-btns">
          <button type="submit" class="ibk-btn-filter">
            <i class="fas fa-filter"></i>ກອງຂໍ້ມູນ
          </button>
          <% if has_filter %>
            <a href="<%= admin_inspections_path %>" class="ibk-btn-clear">
              <i class="fas fa-times"></i>ລ້າງ
            </a>
          <% end %>
        </div>
      </div>
    </form>
  </div>

  <div class="ibk-table-card">
    <div style="overflow-x:auto;">
      <table class="ibk-table">
        <thead>
          <tr>
            <th>ລົດ / ເຈົ້າຂອງ</th>
            <th>ສູນກວດກາ</th>
            <th>ບໍລິການ</th>
            <th>ຈຳນວນ</th>
            <th>ວັນນັດໝາຍ</th>
            <th>ສະຖານະ</th>
            <th>ຈັດການ</th>
          </tr>
        </thead>
        <tbody>
          <% bookings.each do |b| %>
            <% badge = plate_badge_for(b.vehicle) %>
            <tr>
              <td>
                <div style="display:flex;align-items:center;gap:10px;">
                  <div class="plate-badge <%= badge.color_class %>">
                    <% if badge.province %>
                      <span class="plate-province"><%= badge.province %></span>
                    <% end %>
                    <span class="plate-number"><%= badge.number %></span>
                  </div>
                  <div style="font-size:12px;color:#94a3b8;"><i class="fas fa-phone-alt"></i> <%= b.vehicle.user.phone_number %></div>
                </div>
              </td>
              <td style="font-size:13px;color:var(--muted);max-width:200px;">
                <div style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:200px;">
                  <%= b.center_name %>
                </div>
              </td>
              <td style="font-size:13px;color:var(--muted);"><%= b.service_name.presence || '—' %></td>
              <td style="font-size:13px;font-weight:600;">
                <%= b.amount.present? ? number_to_currency(b.amount, unit: "₭", precision: 0, delimiter: ",") : '—' %>
              </td>
              <td style="font-size:13px;color:var(--muted);white-space:nowrap;">
                <%= b.appointment_at.present? ? b.appointment_at.strftime('%d/%m/%Y %H:%M') : '—' %>
              </td>
              <td>
                <span class="ibk-status <%= status_class[b.status] %>"><%= status_label[b.status] || b.status %></span>
              </td>
              <td>
                <div class="ibk-actions">
                  <%= link_to admin_inspection_path(b), class: 'ibk-btn-view' do %>
                    <i class="fas fa-eye"></i>
                  <% end %>
                  <%= link_to edit_admin_inspection_path(b), class: 'ibk-btn-edit' do %>
                    <i class="fas fa-edit"></i>
                  <% end %>
                  <%= button_to admin_inspection_path(b), method: :delete,
                        class: 'ibk-btn-del',
                        form: { style: 'margin:0;' },
                        data: { confirm: "ຢືນຢັນການລົບການຈອງນີ້?" } do %>
                    <i class="fas fa-trash"></i>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>

          <% if bookings.empty? %>
            <tr>
              <td colspan="7">
                <div class="ibk-empty">
                  <i class="fas fa-clipboard-check"></i>
                  <p>ບໍ່ພົບລາຍການຈອງກວດສະພາບລົດ</p>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <% if bookings.respond_to?(:total_pages) && bookings.total_pages > 1 %>
    <div class="ibk-page-wrap" style="display:flex;justify-content:center;margin-top:20px;">
      <%= paginate bookings %>
    </div>
  <% end %>

</div>
