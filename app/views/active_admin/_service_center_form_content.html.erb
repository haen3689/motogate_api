<% c = resource %>
<% type_options = [['ສູນສ້ອມແປງລົດ', 'garage'], ['ສູນຂາຍລົດ', 'dealer'], ['ລາກລົດ 24ຊມ', 'towing']] %>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>
  #titlebar { display:none !important; }
  body.active_admin, #wrapper, #active_admin_content, #main_content,
  #main, .flashes { background:#f4f6f9 !important; }
  #main_content > .panel { background:transparent !important; border:none !important; box-shadow:none !important; padding:0 !important; margin:0 !important; }
  #main_content > .panel > .panel_contents { padding:0 !important; }

  .vef-page {
    --brand:#27bc9c; --brand-d:#1e9e82; --ink:#1f2a37; --muted:#6b7684; --line:#e9edf2; --soft:#f4f6f9;
    color:var(--ink); font-family:"Noto Sans Lao","Phetsarath OT",system-ui,sans-serif;
    max-width:900px;
  }

  .vef-bar { display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom:28px; }
  .vef-bar-l { display:flex; align-items:center; gap:14px; }
  .vef-bar-ico { width:50px; height:50px; border-radius:14px; display:grid; place-items:center;
                 background:linear-gradient(135deg,#27bc9c,#1e9e82); color:#fff; font-size:20px;
                 box-shadow:0 8px 20px rgba(39,188,156,.35); flex-shrink:0; }
  .vef-bar h2 { font-size:21px; font-weight:800; margin:0; }
  .vef-bar p  { font-size:12.5px; color:var(--muted); margin:3px 0 0; }
  .vef-bar-btns { display:flex; gap:10px; }
  .vef-btn { display:inline-flex; align-items:center; gap:7px; padding:10px 22px; border-radius:11px;
             font-size:13.5px; font-weight:700; cursor:pointer; text-decoration:none !important;
             text-shadow:none !important; border:none; transition:.15s; white-space:nowrap;
             font-family:inherit; }
  .vef-btn-save { background:linear-gradient(135deg,#27bc9c,#1e9e82); color:#fff !important;
                  box-shadow:0 6px 16px rgba(39,188,156,.35); }
  .vef-btn-save:hover { filter:brightness(1.07); color:#fff !important; transform:translateY(-1px); }
  .vef-btn-back { background:#fff; border:1.5px solid var(--line); color:var(--muted) !important;
                  box-shadow:0 2px 8px rgba(0,0,0,.06); }
  .vef-btn-back:hover { border-color:#27bc9c; color:#27bc9c !important; }

  .vef-card { background:#fff; border-radius:20px; box-shadow:0 4px 20px rgba(16,24,40,.06);
              padding:28px 32px; margin-bottom:20px; }
  .vef-card-hd { display:flex; align-items:center; justify-content:space-between; gap:10px; font-size:15px; font-weight:800;
                 color:var(--ink); margin-bottom:24px; padding-bottom:14px;
                 border-bottom:2px solid var(--soft); }
  .vef-card-hd-l { display:flex; align-items:center; gap:10px; }
  .vef-card-hd i { width:32px; height:32px; border-radius:9px; display:grid; place-items:center;
                   background:#e6f7f3; color:#27bc9c; font-size:14px; flex-shrink:0; }

  .vef-g2 { display:grid; grid-template-columns:repeat(2,1fr); gap:20px; }
  .vef-field { display:flex; flex-direction:column; gap:6px; }
  .vef-label { font-size:12px; font-weight:700; color:#475569; letter-spacing:.02em; text-transform:uppercase; }
  .vef-label span { color:#ef4444; }
  .vef-input, .vef-page select {
    border:1.5px solid var(--line) !important; border-radius:10px !important;
    padding:11px 14px !important; font-size:13.5px !important; background:#fff !important;
    outline:none !important; font-family:inherit !important; color:var(--ink) !important;
    transition:.2s; width:100% !important; box-sizing:border-box !important;
    min-height:44px !important; line-height:1.4 !important; margin:0 !important;
    box-shadow:none !important; appearance:none; -webkit-appearance:none;
  }
  .vef-input:focus, .vef-page select:focus { border-color:#27bc9c !important; box-shadow:0 0 0 3px rgba(39,188,156,.13) !important; }
  textarea.vef-input { min-height:64px !important; resize:vertical; }

  .vef-status-wrap { display:flex; gap:8px; flex-wrap:wrap; }
  .vef-sr { display:none; }
  .vef-sl { padding:8px 18px; border-radius:9px; border:1.5px solid var(--line);
            background:#fafafa; color:#94a3b8; font-size:13px; font-weight:700;
            cursor:pointer; transition:.15s; user-select:none; }
  .vef-sl:hover { border-color:#27bc9c; color:#27bc9c; }
  #sc_active:checked   + .vef-sl { color:#fff;    background:#16a34a; border-color:#16a34a; }
  #sc_inactive:checked + .vef-sl { color:#dc2626; background:#fff1f2; border-color:#f87171; }

  .vef-errors { background:#fff1f2; border:1.5px solid #fca5a5; border-radius:14px;
                padding:16px 22px; margin-bottom:20px; }
  .vef-errors strong { color:#dc2626; display:block; margin-bottom:8px; }
  .vef-errors li { color:#dc2626; font-size:13px; margin-bottom:2px; }

  .icf-layout { display:grid; grid-template-columns:5fr 7fr; gap:20px; align-items:start; }
  @media (max-width:900px) { .icf-layout { grid-template-columns:1fr; } }

  .icf-logo-wrap { text-align:center; margin-bottom:20px; }
  .icf-logo-preview { width:120px; height:120px; margin:10px auto 14px; border-radius:20px;
                       background:#f8f9fa; border:2px dashed #d8dee6; display:flex;
                       align-items:center; justify-content:center; overflow:hidden; }
  .icf-logo-preview img { width:100%; height:100%; object-fit:cover; }
  .icf-logo-preview i { font-size:32px; color:#c2cad4; }
  .icf-logo-wrap input[type="file"] { max-width:280px; margin:0 auto; }

  .icf-map-wrap { margin-top:4px; }
  .icf-map-btn { border:1.5px solid var(--line); border-radius:9px; background:#f0fdfa; color:#0f766e;
                 font-size:12.5px; font-weight:700; padding:8px 16px; cursor:pointer; margin-bottom:10px;
                 display:inline-flex; align-items:center; gap:6px; }
  .icf-map-btn:hover { background:#e6f7f3; }
  #sc_map { height:280px; border-radius:12px; border:1.5px solid var(--line); margin-top:4px; }
</style>

<div class="vef-page">
  <%= form_with model: [:admin, c], local: true, html: { style:"margin:0;", multipart: true } do |f| %>

    <div class="vef-bar">
      <div class="vef-bar-l">
        <div class="vef-bar-ico"><i class="fas fa-store"></i></div>
        <div>
          <h2><%= c.persisted? ? 'ແກ້ໄຂສູນບໍລິການ' : 'ເພີ່ມສູນບໍລິການໃໝ່' %></h2>
          <p>ຂໍ້ມູນສູນສ້ອມແປງ / ຂາຍລົດ / ລາກລົດ</p>
        </div>
      </div>
      <div class="vef-bar-btns">
        <%= f.submit(c.persisted? ? 'ບັນທຶກການແກ້ໄຂ' : 'ບັນທຶກທັງໝົດ', class: 'vef-btn vef-btn-save') %>
        <%= link_to admin_service_centers_path, class: 'vef-btn vef-btn-back' do %>
          <i class="fas fa-arrow-left"></i>ກັບຄືນ
        <% end %>
      </div>
    </div>

    <% if c.errors.any? %>
      <div class="vef-errors">
        <strong><i class="fas fa-exclamation-circle" style="margin-right:6px;"></i>ກະລຸນາກວດສອບຂໍ້ມູນ</strong>
        <ul style="margin:0;padding-left:18px;">
          <% c.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="icf-layout">
      <div>
        <div class="vef-card">
          <div class="vef-card-hd">
            <div class="vef-card-hd-l"><i class="fas fa-store"></i>ຂໍ້ມູນສູນບໍລິການ</div>
          </div>

          <div class="icf-logo-wrap">
            <label class="vef-label" style="display:block;">ໂລໂກ້</label>
            <div class="icf-logo-preview" id="scLogoPreview">
              <% if c.logo.present? %>
                <img src="<%= c.logo %>" alt="logo">
              <% else %>
                <i class="fas fa-store"></i>
              <% end %>
            </div>
            <%= f.file_field :logo_file, class: 'vef-input', accept: 'image/*', id: 'scLogoFileInput' %>
          </div>

          <div class="vef-field" style="margin-bottom:20px;">
            <label class="vef-label">ປະເພດ <span>*</span></label>
            <%= f.select :service_type, type_options %>
          </div>

          <div class="vef-field" style="margin-bottom:20px;">
            <label class="vef-label">ຊື່ສູນບໍລິການ <span>*</span></label>
            <%= f.text_field :name, class: 'vef-input', placeholder: 'ຊື່ສູນບໍລິການ...' %>
          </div>

          <div class="vef-field" style="margin-bottom:20px;">
            <label class="vef-label">ຈຸດເດັ່ນ / ປະເພດການບໍລິການ</label>
            <%= f.text_field :specialty, class: 'vef-input', placeholder: 'ຕົວຢ່າງ: ສ້ອມແປງທົ່ວໄປ, ລະບົບໄຟ, ປ່ຽນຖ່າຍນ້ຳມັນເຄື່ອງ' %>
          </div>

          <div class="vef-g2" style="margin-bottom:20px;">
            <div class="vef-field">
              <label class="vef-label">ຊື່ເຈົ້າຂອງ/ພາດເນີ</label>
              <%= f.text_field :owner_name, class: 'vef-input' %>
            </div>
            <div class="vef-field">
              <label class="vef-label">ເບີໂທລະສັບ</label>
              <%= f.text_field :phone, class: 'vef-input', placeholder: '020 XXXXXXXX' %>
            </div>
          </div>

          <div class="vef-field" style="margin-bottom:20px;">
            <label class="vef-label">ຄະແນນ (0-5)</label>
            <%= f.number_field :rating, class: 'vef-input', step: '0.1', min: 0, max: 5 %>
          </div>

          <div class="vef-field">
            <label class="vef-label">ສະຖານະ</label>
            <div class="vef-status-wrap">
              <%= f.radio_button :status, 'active', id: 'sc_active', class: 'vef-sr', checked: c.status != 'inactive' %>
              <label class="vef-sl" for="sc_active">ເປີດໃຫ້ບໍລິການ</label>
              <%= f.radio_button :status, 'inactive', id: 'sc_inactive', class: 'vef-sr' %>
              <label class="vef-sl" for="sc_inactive">ປິດໃຫ້ບໍລິການ</label>
            </div>
          </div>
        </div>
      </div>

      <div>
        <div class="vef-card">
          <div class="vef-card-hd">
            <div class="vef-card-hd-l"><i class="fas fa-location-dot"></i>ທີ່ຕັ້ງ</div>
          </div>

          <div class="vef-field" style="margin-bottom:20px;">
            <label class="vef-label">ທີ່ຢູ່</label>
            <%= f.text_area :location, class: 'vef-input', rows: 2, placeholder: 'ບ້ານ, ເມືອງ, ແຂວງ...' %>
          </div>

          <div class="vef-g2" style="margin-bottom:8px;">
            <div class="vef-field">
              <label class="vef-label">Latitude</label>
              <%= f.text_field :lat, class: 'vef-input', placeholder: '17.9757', id: 'sc_lat' %>
            </div>
            <div class="vef-field">
              <label class="vef-label">Longitude</label>
              <%= f.text_field :lng, class: 'vef-input', placeholder: '102.6331', id: 'sc_lng' %>
            </div>
          </div>

          <div class="vef-field icf-map-wrap">
            <label class="vef-label">ພິກັດ GPS (ຄລິກ ຫຼື ລາກໝຸດເທິງແຜນທີ່)</label>
            <button type="button" class="icf-map-btn" id="sc_btn_get_location">
              <i class="fas fa-crosshairs"></i>ປັກໝຸດປັດຈຸບັນ
            </button>
            <div id="sc_map"></div>
          </div>
        </div>
      </div>
    </div>

  <% end %>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
  var scLogoFileInput = document.getElementById('scLogoFileInput');
  if (scLogoFileInput) {
    scLogoFileInput.addEventListener('change', function () {
      var file = this.files[0];
      if (!file) return;
      var reader = new FileReader();
      reader.onload = function (e) {
        document.getElementById('scLogoPreview').innerHTML = '<img src="' + e.target.result + '" alt="logo">';
      };
      reader.readAsDataURL(file);
    });
  }

  (function () {
    function boot() {
      var latInput = document.getElementById('sc_lat');
      var lngInput = document.getElementById('sc_lng');
      var mapDiv = document.getElementById('sc_map');
      var btn = document.getElementById('sc_btn_get_location');
      if (!latInput || !lngInput || !mapDiv || typeof L === 'undefined') return;

      var defaultLat = parseFloat(latInput.value) || 17.9757;
      var defaultLng = parseFloat(lngInput.value) || 102.6331;

      var map = L.map(mapDiv).setView([defaultLat, defaultLng], 13);
      L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
        attribution: '&copy; OpenStreetMap &copy; CARTO', subdomains: 'abcd', maxZoom: 20
      }).addTo(map);

      var marker = L.marker([defaultLat, defaultLng], { draggable: true }).addTo(map);

      function updateInputs(lat, lng) {
        latInput.value = lat.toFixed(6);
        lngInput.value = lng.toFixed(6);
      }

      marker.on('dragend', function () {
        var pos = marker.getLatLng();
        updateInputs(pos.lat, pos.lng);
      });
      map.on('click', function (e) {
        marker.setLatLng(e.latlng);
        updateInputs(e.latlng.lat, e.latlng.lng);
      });

      if (btn) {
        btn.addEventListener('click', function () {
          if (!navigator.geolocation) { alert('ບໍ່ຮອງຮັບ GPS ໃນອຸປະກອນນີ້'); return; }
          var originalText = btn.innerHTML;
          btn.disabled = true;
          btn.innerHTML = 'ກຳລັງຄົ້ນຫາ...';
          navigator.geolocation.getCurrentPosition(function (pos) {
            map.setView([pos.coords.latitude, pos.coords.longitude], 15);
            marker.setLatLng([pos.coords.latitude, pos.coords.longitude]);
            updateInputs(pos.coords.latitude, pos.coords.longitude);
            btn.disabled = false;
            btn.innerHTML = originalText;
          }, function () {
            alert('ບໍ່ສາມາດເຂົ້າເຖິງ GPS ຂອງທ່ານໄດ້');
            btn.disabled = false;
            btn.innerHTML = originalText;
          });
        });
      }

      setTimeout(function () { map.invalidateSize(); }, 300);
    }
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', boot); } else { boot(); }
  })();
</script>
