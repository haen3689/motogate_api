<% content_for :title, "ລາຍລະອຽດລົດ: #{@vehicle.brand} #{@vehicle.model}" %>

<style>
  .view-card { background:#fff; border-radius:16px; border:1px solid #e2e8f0; padding:24px; margin-bottom:20px; }
  .section-hdr { font-size:.95rem; font-weight:800; color:#1e293b; padding-bottom:14px; border-bottom:2px solid #f1f5f9; margin-bottom:18px; display:flex; align-items:center; gap:8px; }
  .section-hdr i { color:#27bc9c; }
  .lbl { color:#94a3b8; font-size:.72rem; text-transform:uppercase; font-weight:700; letter-spacing:.05em; margin-bottom:3px; }
  .val { color:#1e293b; font-weight:600; font-size:.92rem; margin-bottom:18px; }
  .plate-lg { display:inline-block; padding:8px 22px; border-radius:10px; font-weight:900; font-size:1.4rem; border:3px solid #333; background:#FFD600; color:#000; letter-spacing:.05em; }
</style>

<%# ── Breadcrumb + Actions ── %>
<div class="pg-hdr">
  <div class="pg-title">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-1" style="font-size:.82rem;">
        <li class="breadcrumb-item"><%= link_to 'ລາຍການພາຫານະ', dashboard_vehicles_path, class:'text-decoration-none', style:'color:#27bc9c;' %></li>
        <li class="breadcrumb-item active text-muted">ລາຍລະອຽດ</li>
      </ol>
    </nav>
    <h1><i class="fas fa-car"></i>ລົດ: <%= [@vehicle.brand, @vehicle.model].compact.join(' ').presence || @vehicle.plate_number %></h1>
  </div>
  <div class="d-flex gap-2">
    <button class="btn btn-outline-dark btn-sm px-3" onclick="window.print()">
      <i class="fas fa-print me-1"></i>ພິມຂໍ້ມູນ
    </button>
    <%= link_to dashboard_vehicles_path, class: 'btn btn-light border btn-sm px-3 text-muted' do %>
      <i class="fas fa-arrow-left me-1"></i>ກັບຄືນ
    <% end %>
  </div>
</div>

<div class="row g-4">

  <%# ── Left: Vehicle Info ── %>
  <div class="col-lg-8">

    <%# General Info %>
    <div class="view-card">
      <div class="section-hdr"><i class="fas fa-info-circle"></i>ຂໍ້ມູນທົ່ວໄປຂອງລົດ</div>
      <div class="row">
        <div class="col-md-6">
          <div class="lbl">ຍີ່ຫໍ້</div>
          <div class="val"><%= @vehicle.brand.presence || '-' %></div>

          <div class="lbl">ລຸ້ນ</div>
          <div class="val"><%= @vehicle.model.presence || '-' %></div>

          <div class="lbl">ປີ</div>
          <div class="val"><%= @vehicle.year.presence || '-' %></div>

          <div class="lbl">ສີ</div>
          <div class="val"><%= @vehicle.color.presence || '-' %></div>
        </div>
        <div class="col-md-6">
          <div class="lbl">ເລກຈັກ (Engine No.)</div>
          <div class="val"><%= @vehicle.engine_number.presence || '-' %></div>

          <div class="lbl">ເລກຖັງ (Chassis No.)</div>
          <div class="val"><%= @vehicle.chassis_number.presence || '-' %></div>

          <div class="lbl">ຂະໜາດເຄື່ອງ (CC)</div>
          <div class="val"><%= @vehicle.cc.present? ? "#{@vehicle.cc} cc" : '-' %></div>

          <div class="lbl">ປະເພດການໃຊ້ງານ</div>
          <div class="val"><%= @vehicle.usage_type.presence || '-' %></div>
        </div>
      </div>
    </div>

    <%# Documents %>
    <div class="view-card">
      <div class="section-hdr"><i class="fas fa-file-image"></i>ໃບທະບຽນລົດ</div>
      <div class="row g-3">
        <div class="col-md-6">
          <div class="lbl mb-2">ດ້ານໜ້າ</div>
          <% if @vehicle.registration_front.attached? %>
            <%= image_tag url_for(@vehicle.registration_front), class: 'img-fluid rounded', style: 'border:1px solid #e2e8f0;max-height:200px;object-fit:cover;' %>
          <% else %>
            <div class="d-flex align-items-center justify-content-center rounded" style="height:120px;background:#f8fafc;border:2px dashed #e2e8f0;">
              <span class="text-muted small"><i class="fas fa-image me-1"></i>ຍັງບໍ່ມີຮູບ</span>
            </div>
          <% end %>
        </div>
        <div class="col-md-6">
          <div class="lbl mb-2">ດ້ານຫຼັງ</div>
          <% if @vehicle.registration_back.attached? %>
            <%= image_tag url_for(@vehicle.registration_back), class: 'img-fluid rounded', style: 'border:1px solid #e2e8f0;max-height:200px;object-fit:cover;' %>
          <% else %>
            <div class="d-flex align-items-center justify-content-center rounded" style="height:120px;background:#f8fafc;border:2px dashed #e2e8f0;">
              <span class="text-muted small"><i class="fas fa-image me-1"></i>ຍັງບໍ່ມີຮູບ</span>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# Road Taxes %>
    <% if @vehicle.road_taxes.any? %>
      <div class="view-card">
        <div class="section-hdr"><i class="fas fa-road"></i>ຂໍ້ມູນຄ່າທາງ</div>
        <div class="table-responsive">
          <table class="table table-sm mb-0">
            <thead>
              <tr>
                <th>ປີ</th>
                <th>ຈຳນວນ</th>
                <th>ສະຖານະ</th>
                <th>ໝົດອາຍຸ</th>
              </tr>
            </thead>
            <tbody>
              <% @vehicle.road_taxes.each do |rt| %>
                <tr>
                  <td><%= rt.tax_year %></td>
                  <td><%= rt.amount %></td>
                  <td>
                    <span class="<%= rt.status == 'active' ? 'badge-active' : 'badge-inactive' %>">
                      <%= rt.status %>
                    </span>
                  </td>
                  <td><%= rt.expired_at&.strftime('%d/%m/%Y') %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>

    <%# Inspections %>
    <% if @vehicle.inspections.any? %>
      <div class="view-card">
        <div class="section-hdr"><i class="fas fa-clipboard-check"></i>ປະຫວັດການກວດເຕັກນິກ</div>
        <div class="table-responsive">
          <table class="table table-sm mb-0">
            <thead>
              <tr>
                <th>ສູນກວດ</th>
                <th>ວັນທີກວດ</th>
                <th>ສະຖານະ</th>
              </tr>
            </thead>
            <tbody>
              <% @vehicle.inspections.order(created_at: :desc).each do |ins| %>
                <tr>
                  <td><%= ins.respond_to?(:center_name) ? ins.center_name : '-' %></td>
                  <td><%= ins.created_at.strftime('%d/%m/%Y') %></td>
                  <td>
                    <span class="<%= ins.status == 'passed' ? 'badge-active' : 'badge-inactive' %>">
                      <%= ins.status %>
                    </span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>

  </div>

  <%# ── Right: Plate + Owner ── %>
  <div class="col-lg-4">

    <%# Plate Badge %>
    <div class="view-card text-center">
      <div class="section-hdr justify-content-center"><i class="fas fa-id-card"></i>ປ້າຍທະບຽນ</div>
      <div class="mb-3">
        <span class="plate-lg"><%= @vehicle.plate_number %></span>
      </div>
      <% if @vehicle.province.present? %>
        <div class="text-muted small mb-2"><i class="fas fa-map-marker-alt me-1"></i><%= @vehicle.province %></div>
      <% end %>
      <div class="mt-2">
        <% case @vehicle.vehicle_type
           when 'motorcycle' %>
          <span class="badge-moto"><i class="fas fa-motorcycle me-1"></i>ລົດຈັກ</span>
        <% when 'car' %>
          <span class="badge-car"><i class="fas fa-car me-1"></i>ລົດຍົນ</span>
        <% when 'truck' %>
          <span class="badge-truck"><i class="fas fa-truck me-1"></i>ລົດບັນທຸກ</span>
        <% end %>
      </div>
    </div>

    <%# Owner Info %>
    <div class="view-card">
      <div class="section-hdr"><i class="fas fa-user"></i>ຂໍ້ມູນເຈົ້າຂອງລົດ</div>
      <% owner = @vehicle.user %>

      <div class="lbl">ຊື່</div>
      <div class="val"><%= [owner.first_name, owner.last_name].compact.join(' ').presence || owner.name.presence || '-' %></div>

      <div class="lbl">ເບີໂທລະສັບ</div>
      <div class="val" style="color:#27bc9c;"><%= owner.phone_number %></div>

      <% if owner.province.present? %>
        <div class="lbl">ແຂວງ</div>
        <div class="val"><%= owner.province %></div>
      <% end %>

      <div class="mt-3">
        <%= link_to dashboard_user_path(owner), class: 'btn btn-outline-primary btn-sm w-100' do %>
          <i class="fas fa-search me-1"></i>ເບິ່ງຂໍ້ມູນເຈົ້າຂອງ
        <% end %>
      </div>
    </div>

    <%# Metadata %>
    <div class="view-card">
      <div class="section-hdr"><i class="fas fa-clock"></i>ຂໍ້ມູນລະບົບ</div>
      <div class="lbl">ວັນທີລົງທະບຽນ</div>
      <div class="val"><%= @vehicle.created_at.strftime('%d/%m/%Y %H:%M') %></div>

      <div class="lbl">ອັບເດດລ່າສຸດ</div>
      <div class="val"><%= @vehicle.updated_at.strftime('%d/%m/%Y %H:%M') %></div>

      <div class="lbl">ID</div>
      <div class="val text-muted">#<%= @vehicle.id %></div>
    </div>

    <%# Danger Zone %>
    <div class="view-card" style="border:1px solid #fecaca;">
      <div class="section-hdr" style="color:#dc2626;border-color:#fecaca;">
        <i class="fas fa-exclamation-triangle" style="color:#dc2626;"></i>ການກຳຈັດ
      </div>
      <%= button_to dashboard_vehicle_path(@vehicle), method: :delete,
          class: 'btn btn-outline-danger btn-sm w-100',
          form: { data: { turbo_confirm: "ຢືນຢັນການລົບລົດ #{@vehicle.plate_number}? ຂໍ້ມູນທັງໝົດຈະຖືກລົບ" } } do %>
        <i class="fas fa-trash me-1"></i>ລົບຂໍ້ມູນລົດ
      <% end %>
    </div>

  </div>
</div>

<style>
  @media print {
    .mg-navbar, .mg-sidebar, .btn, .breadcrumb, .pg-hdr .d-flex { display:none !important; }
    .mg-main { padding: 0 !important; }
    .view-card { box-shadow: none !important; border: 1px solid #eee !important; page-break-inside: avoid; }
  }
</style>
