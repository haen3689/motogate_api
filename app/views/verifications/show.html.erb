<% if @valid && @vehicle %>
  <%# ── Single-vehicle "staff view" — matches Figma QRScanResult-StaffView v2 ── %>
  <div style="background:#fff;border-radius:0 0 28px 28px;box-shadow:0 2px 12px rgba(0,0,0,.06);
              padding:18px 20px 20px;margin:0 -24px 16px;display:flex;align-items:flex-start;justify-content:space-between;gap:10px;">
    <div style="width:24px;"></div>
    <div style="flex:1;text-align:center;">
      <div style="font-size:18px;font-weight:800;color:#1A1A1A;">ຢືນຢັນເອກະສານແລ້ວ</div>
      <div style="display:inline-block;background:#F6F7F7;border-radius:12px;padding:4px 14px;margin-top:8px;">
        <span style="font-size:10.5px;color:#5C7B76;">ກວດສອບເມື່ອ <%= @checked_at.strftime("%d/%m/%Y %H:%M") %></span>
      </div>
    </div>
    <div style="width:56px;height:56px;border-radius:50%;background:#F6F7F7;border:2px solid #D9F7F2;
                display:flex;flex-direction:column;align-items:center;justify-content:center;flex-shrink:0;">
      <div style="font-size:16px;font-weight:800;color:#1A1A1A;line-height:1;"><%= @ok_count %>/<%= @checks.size %></div>
      <div style="font-size:8px;font-weight:600;color:#5C7B76;margin-top:2px;">OK</div>
    </div>
  </div>

  <div style="background:#fff;border-radius:16px;box-shadow:0 2px 12px rgba(0,0,0,.05);padding:12px;
              display:flex;align-items:center;gap:12px;margin-bottom:14px;">
    <div style="background:#FFD600;border:1.5px solid #1A1A1A;border-radius:10px;padding:10px 8px;
                min-width:80px;text-align:center;flex-shrink:0;">
      <span style="font-size:13px;font-weight:800;color:#1A1A1A;"><%= @vehicle.plate_number.presence || "—" %></span>
    </div>
    <div style="min-width:0;flex:1;">
      <div style="font-size:13px;font-weight:800;color:#1A1A1A;">
        <%= [@vehicle.brand, @vehicle.model].compact_blank.join(" ").presence || "—" %>
      </div>
      <div style="font-size:10.5px;color:#8C8C8C;margin-top:2px;">
        <%= [@vehicle.vehicle_type&.upcase, (@vehicle.cc.present? ? "#{@vehicle.cc}CC" : nil), @vehicle.year].compact_blank.join(" · ") %>
      </div>
      <% if @vehicle.engine_number.present? %>
        <div style="font-size:9.5px;color:#A6A6A6;margin-top:4px;">ເລກຈັກ: <%= @vehicle.engine_number %></div>
      <% end %>
    </div>
  </div>

  <% @checks.select { |c| c[:status] == :expired }.each do |c| %>
    <div style="background:#FEEED7;border:1.5px solid #BC770C;border-radius:13px;padding:11px 13px;margin-bottom:12px;">
      <span style="font-size:11.5px;font-weight:700;color:#BC770C;">
        ⚠ <%= c[:label] %>ໝົດອາຍຸ <%= c[:date]&.strftime("%d/%m/%Y") %> — ຕ້ອງດຳເນີນການ!
      </span>
    </div>
  <% end %>

  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
    <span style="font-size:13px;font-weight:800;color:#1A1A1A;">ສະຖານະເອກະສານ</span>
    <div style="background:#F0FAF9;border:1px solid #D0EEEC;border-radius:11px;padding:3px 10px;">
      <span style="font-size:10px;font-weight:800;color:#0F9B8E;"><%= @ok_count %>✓ <%= @fail_count %>✗</span>
    </div>
  </div>

  <div style="background:#fff;border-radius:18px;box-shadow:0 2px 12px rgba(0,0,0,.06);overflow:hidden;margin-bottom:14px;">
    <% @checks.each_with_index do |c, i| %>
      <% ok = c[:status] == :valid %>
      <% bad = c[:status] == :expired %>
      <div style="display:flex;align-items:center;gap:12px;padding:12px;
                  <%= "background:#FFF5F5;" if bad %>
                  <%= "border-top:1px solid #D0EEEC;" if i > 0 %>">
        <div style="width:36px;height:36px;border-radius:18px;flex-shrink:0;display:flex;align-items:center;justify-content:center;
                    background:<%= ok ? "#E0F7E9" : (bad ? "#FCE0E0" : "#FEF3C7") %>;
                    color:<%= ok ? "#009951" : (bad ? "#CC1010" : "#CA8A04") %>;font-weight:800;font-size:16px;">
          <%= ok ? "✓" : (bad ? "✗" : "!") %>
        </div>
        <div style="flex:1;min-width:0;">
          <div style="font-size:13px;font-weight:800;color:<%= bad ? "#CC1010" : "#1A1A1A" %>;"><%= c[:label] %></div>
          <div style="font-size:10px;color:#8C8C8C;margin-top:2px;"><%= c[:subtitle] %></div>
        </div>
        <div style="background:<%= ok ? "#E0F7E9" : (bad ? "#FCE0E0" : "#FEF3C7") %>;border-radius:9px;padding:5px 10px;flex-shrink:0;">
          <span style="font-size:9px;font-weight:800;color:<%= ok ? "#009951" : (bad ? "#CC1010" : "#CA8A04") %>;white-space:nowrap;">
            <% if c[:date].present? %>
              <%= bad ? "ໝົດ " : "" %><%= c[:date].strftime("%d/%m/%Y") %>
            <% else %>
              ບໍ່ມີຂໍ້ມູນ
            <% end %>
          </span>
        </div>
      </div>
    <% end %>
  </div>

  <div style="display:flex;gap:10px;margin-bottom:14px;">
    <div style="flex:1;background:#0F9B8E;border-radius:16px;box-shadow:0 4px 12px rgba(0,0,0,.15);
                padding:16px;text-align:center;">
      <span style="font-size:14px;font-weight:800;color:#fff;">📋 ລາຍລະອຽດ</span>
    </div>
    <div style="flex:1;background:#CC1010;border-radius:16px;box-shadow:0 4px 12px rgba(0,0,0,.15);
                padding:16px;text-align:center;">
      <span style="font-size:14px;font-weight:800;color:#fff;">🔄 ຕໍ່ປະກັນ</span>
    </div>
  </div>

  <%= link_to verification_report_path(params[:token]),
        target: "_blank", rel: "noopener",
        style: "display:block;width:100%;background:#F0FAF9;border:1.5px solid #D0EEEC;border-radius:14px;" \
               "padding:14px;text-align:center;font-size:13px;font-weight:600;color:#0F9B8E;" \
               "text-decoration:none;margin-bottom:14px;box-sizing:border-box;" do %>
    🖨 Export PDF / ພິມລາຍງານ
  <% end %>

  <div style="background:#EDF0F5;border-radius:10px;padding:9px 12px;">
    <span style="font-size:9.5px;color:#8C8C8C;line-height:1.5;">
      ອອກໂດຍ MotoGate — QR ນີ້ໃຊ້ໄດ້ພຽງໄລຍະສັ້ນ ຂໍ້ມູນອາດປ່ຽນແປງໄດ້ຫຼັງຈາກເວລານີ້
    </span>
  </div>

<% elsif @valid %>
  <%# ── Multi-vehicle summary (unscoped token) ── %>
  <div style="background:#fff;border-radius:20px;padding:28px 24px;box-shadow:0 8px 28px rgba(15,45,40,.08);">
    <div style="text-align:center;margin-bottom:20px;">
      <div style="width:56px;height:56px;border-radius:50%;background:#DCFCE7;display:flex;
                  align-items:center;justify-content:center;margin:0 auto 12px;font-size:28px;">✅</div>
      <div style="font-size:17px;font-weight:800;">ຢືນຢັນເອກະສານແລ້ວ</div>
      <div style="font-size:12px;color:#8C8C8C;margin-top:4px;">
        ກວດສອບເມື່ອ <%= @checked_at.strftime("%d/%m/%Y %H:%M") %>
      </div>
    </div>

    <div style="border-top:1px solid #EBEBEB;padding-top:16px;margin-bottom:16px;">
      <div style="font-size:16px;font-weight:800;">
        <%= [@user.first_name, @user.last_name].compact_blank.join(" ").presence || @user.name.presence || "—" %>
      </div>
      <div style="font-size:13px;color:#8C8C8C;margin-top:2px;"><%= @user.phone_number %></div>
      <div style="margin-top:10px;display:flex;align-items:center;gap:8px;">
        <span style="font-size:13px;font-weight:600;">ໃບຂັບຂີ:</span>
        <%= status_badge(@license_status) %>
      </div>
    </div>

    <% if @vehicle_rows.any? %>
      <div style="font-size:13px;font-weight:800;color:#8C8C8C;text-transform:uppercase;
                  letter-spacing:.05em;margin-bottom:10px;">ພາຫະນະ (<%= @vehicle_rows.size %>)</div>
      <% @vehicle_rows.each do |row| %>
        <div style="border:1px solid #EBEBEB;border-radius:14px;padding:14px;margin-bottom:10px;">
          <div style="font-weight:800;font-size:14px;margin-bottom:8px;">
            <%= row[:vehicle].plate_number.presence || "ຍັງບໍ່ມີທະບຽນ" %>
            <span style="font-weight:400;color:#8C8C8C;font-size:12.5px;">
              <%= [row[:vehicle].brand, row[:vehicle].model].compact_blank.join(" ") %>
            </span>
          </div>
          <div style="display:flex;flex-wrap:wrap;gap:8px;">
            <span style="font-size:12.5px;color:#8C8C8C;">ຄ່າທາງ</span>
            <%= status_badge(row[:road_tax_status]) %>
            <span style="font-size:12.5px;color:#8C8C8C;margin-left:8px;">ປະກັນໄພ</span>
            <%= status_badge(row[:insurance_status]) %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div style="text-align:center;color:#8C8C8C;font-size:13px;padding:16px 0;">
        ຍັງບໍ່ມີພາຫະນະໃນລະບົບ
      </div>
    <% end %>

    <div style="text-align:center;font-size:11.5px;color:#8C8C8C;margin-top:18px;line-height:1.6;">
      ອອກໂດຍ MotoGate — QR ນີ້ໃຊ້ໄດ້ພຽງໄລຍະສັ້ນ ຂໍ້ມູນອາດປ່ຽນແປງໄດ້ຫຼັງຈາກເວລານີ້
    </div>
  </div>
<% else %>
  <div style="background:#fff;border-radius:20px;padding:36px 24px;box-shadow:0 8px 28px rgba(15,45,40,.08);text-align:center;">
    <div style="width:56px;height:56px;border-radius:50%;background:#FEE2E2;display:flex;
                align-items:center;justify-content:center;margin:0 auto 14px;font-size:28px;">❌</div>
    <div style="font-size:17px;font-weight:800;margin-bottom:6px;"><%= @error_message %></div>
    <div style="font-size:13px;color:#8C8C8C;line-height:1.6;">
      QR code ນີ້ອາດໝົດອາຍຸແລ້ວ ຫຼືບໍ່ຖືກຕ້ອງ<br>ກະລຸນາຂໍໃຫ້ເຈົ້າຂອງເປີດ QR ໃໝ່
    </div>
  </div>
<% end %>
