<!DOCTYPE html>
<html lang="lo">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content_for?(:title) ? yield(:title) : 'MotoGate Admin' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Lao:wght@400;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root { --primary: #27bc9c; --primary-dark: #1e9e82; --sidebar-w: 240px; }
    * { font-family: 'Noto Sans Lao', 'Inter', sans-serif; }
    body { background: #f1f5f9; margin: 0; }

    /* ── Navbar ── */
    .mg-navbar {
      height: 56px; background: #fff; border-bottom: 1px solid #e2e8f0;
      display: flex; align-items: center; padding: 0 20px;
      position: sticky; top: 0; z-index: 100;
      box-shadow: 0 1px 4px rgba(0,0,0,.06);
    }
    .mg-navbar .brand { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 1.1rem; color: var(--primary); text-decoration: none; }
    .mg-navbar .brand img { width: 32px; height: 32px; border-radius: 8px; }
    .mg-navbar .spacer { flex: 1; }
    .mg-navbar .admin-chip { display: flex; align-items: center; gap: 8px; font-size: .85rem; color: #475569; }
    .mg-navbar .admin-chip .avatar { width: 32px; height: 32px; background: linear-gradient(135deg,var(--primary),var(--primary-dark)); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; font-size: .8rem; }

    /* ── Wrapper ── */
    .mg-wrapper { display: flex; min-height: calc(100vh - 56px); }

    /* ── Sidebar ── */
    .mg-sidebar { width: var(--sidebar-w); background: #fff; border-right: 1px solid #e2e8f0; flex-shrink: 0; overflow-y: auto; padding: 16px 12px 40px; }
    .mg-sidebar::-webkit-scrollbar { width: 4px; }
    .mg-sidebar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
    .menu-hdr { color: #94a3b8; font-size: .72rem; text-transform: uppercase; letter-spacing: .06em; font-weight: 700; padding: 0 6px; margin: 18px 0 6px; }
    .menu-hdr:first-child { margin-top: 0; }
    .s-link { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border-radius: 10px; color: #475569; text-decoration: none; font-size: .88rem; font-weight: 600; margin-bottom: 2px; transition: all .2s; }
    .s-link:hover { background: #f1f5f9; color: var(--primary); }
    .s-link.active { background: linear-gradient(135deg, var(--primary), var(--primary-dark)); color: #fff; box-shadow: 0 4px 12px rgba(39,188,156,.25); }
    .s-link.parent-active { background: #f0fdfa; color: #0f766e; }
    .s-link i { width: 16px; text-align: center; font-size: .9rem; }
    .s-sub { list-style: none; padding: 0 0 6px 32px; margin: 0; }
    .s-sub a { display: block; padding: 7px 0; color: #64748b; text-decoration: none; font-size: .85rem; font-weight: 500; transition: color .2s; }
    .s-sub a:hover, .s-sub a.active { color: var(--primary); font-weight: 700; }
    .arrow { font-size: .7rem; margin-left: auto; transition: transform .3s; }
    .s-link[aria-expanded="true"] .arrow { transform: rotate(180deg); }
    .badge-dot { background: #ef4444; color: #fff; font-size: .68rem; font-weight: 700; padding: 1px 7px; border-radius: 10px; margin-left: auto; }

    /* ── Main content ── */
    .mg-main { flex: 1; padding: 24px 28px; min-width: 0; }

    /* ── Page header ── */
    .pg-hdr { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 22px; flex-wrap: wrap; gap: 12px; }
    .pg-title h1 { font-size: 1.4rem; font-weight: 800; color: #1e293b; margin: 0 0 3px; }
    .pg-title h1 i { color: var(--primary); margin-right: 8px; }
    .pg-title p { margin: 0; font-size: .85rem; color: #64748b; }

    /* ── Stat cards ── */
    .stats-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 16px; margin-bottom: 24px; }
    @media(max-width:1199px){ .stats-grid{ grid-template-columns:repeat(2,1fr); } }
    .stat-card { background: #fff; border-radius: 16px; padding: 20px 22px; border: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; transition: all .25s; text-decoration: none; color: inherit; }
    .stat-card:hover { transform: translateY(-3px); box-shadow: 0 10px 24px rgba(0,0,0,.07); color: inherit; }
    .stat-label { font-size: .8rem; color: #64748b; font-weight: 500; margin-bottom: 6px; }
    .stat-value { font-size: 1.8rem; font-weight: 800; color: #1e293b; line-height: 1; }
    .stat-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; }

    /* ── Data card ── */
    .data-card { background: #fff; border-radius: 16px; border: 1px solid #e2e8f0; overflow: hidden; margin-bottom: 22px; }
    .data-card-hdr { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-bottom: 1px solid #f1f5f9; }
    .data-card-hdr h5 { font-size: .95rem; font-weight: 700; color: #334155; margin: 0; }
    .data-card table thead th { background: #f8fafc; color: #64748b; font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .4px; padding: 12px 18px; border-bottom: 1px solid #e2e8f0; white-space: nowrap; }
    .data-card table tbody td { padding: 13px 18px; color: #475569; font-size: .88rem; vertical-align: middle; border-bottom: 1px solid #f1f5f9; }
    .data-card table tbody tr:last-child td { border-bottom: none; }
    .data-card table tbody tr:hover { background: #f8fafc; }

    /* ── Badges ── */
    .badge-active   { background: #dcfce7; color: #16a34a; padding: 4px 12px; border-radius: 20px; font-size: .75rem; font-weight: 700; }
    .badge-inactive { background: #fee2e2; color: #dc2626; padding: 4px 12px; border-radius: 20px; font-size: .75rem; font-weight: 700; }
    .badge-moto  { background: #dbeafe; color: #2563eb; padding: 4px 10px; border-radius: 20px; font-size: .75rem; font-weight: 600; }
    .badge-car   { background: #f0fdf4; color: #16a34a; padding: 4px 10px; border-radius: 20px; font-size: .75rem; font-weight: 600; }
    .badge-truck { background: #fef9c3; color: #ca8a04; padding: 4px 10px; border-radius: 20px; font-size: .75rem; font-weight: 600; }

    /* ── Plate badge ── */
    .plate-badge { display: inline-block; padding: 3px 12px; border-radius: 6px; font-weight: 900; font-size: .95rem; border: 2px solid #333; background: #FFD600; color: #000; }

    /* ── Info card ── */
    .info-card { background: #fff; border-radius: 16px; border: 1px solid #e2e8f0; padding: 20px; margin-bottom: 16px; border-left: 4px solid var(--primary); }

    /* ── Btn primary ── */
    .btn-primary { background: linear-gradient(135deg,var(--primary),var(--primary-dark)); border: none; }
    .btn-primary:hover { background: linear-gradient(135deg,#24ab8e,#1b8f75); }

    /* ── Filter bar ── */
    .filter-bar { background: #fff; border-radius: 14px; border: 1px solid #e2e8f0; padding: 14px 18px; margin-bottom: 18px; }

    /* ── Flash ── */
    .flash-notice { background: #dcfce7; color: #166534; padding: 12px 18px; border-radius: 10px; margin-bottom: 16px; font-weight: 600; }
    .flash-alert  { background: #fee2e2; color: #991b1b; padding: 12px 18px; border-radius: 10px; margin-bottom: 16px; font-weight: 600; }
  </style>
</head>
<body>

  <%# ── Navbar ── %>
  <nav class="mg-navbar">
    <%= link_to dashboard_root_path, class: 'brand' do %>
      <div style="width:32px;height:32px;background:linear-gradient(135deg,#27bc9c,#1e9e82);border-radius:8px;display:flex;align-items:center;justify-content:center;">
        <i class="fas fa-motorcycle" style="color:#fff;font-size:.9rem;"></i>
      </div>
      MotoGate
    <% end %>
    <div class="spacer"></div>
    <div class="admin-chip">
      <div class="avatar"><%= current_admin.email[0].upcase %></div>
      <span><%= current_admin.email %></span>
      &nbsp;·&nbsp;
      <%= link_to 'ອອກ', destroy_admin_user_session_path, method: :delete, style: 'color:#ef4444;text-decoration:none;font-weight:600;font-size:.85rem;' %>
    </div>
  </nav>

  <div class="mg-wrapper">
    <%# ── Sidebar ── %>
    <aside class="mg-sidebar">
      <p class="menu-hdr">ເມນູຫຼັກ</p>

      <%= link_to dashboard_root_path, class: "s-link #{controller_path == 'dashboard/home' ? 'active' : ''}" do %>
        <i class="fas fa-home"></i> Dashboard
      <% end %>

      <%= link_to dashboard_users_path, class: "s-link #{controller_path == 'dashboard/users' ? 'active' : ''}" do %>
        <i class="fas fa-users"></i> ລູກຄ້າທັງໝົດ
      <% end %>

      <%= link_to dashboard_vehicles_path, class: "s-link #{controller_path == 'dashboard/vehicles' ? 'active' : ''}" do %>
        <i class="fas fa-car"></i> ລາຍການພາຫານະ
      <% end %>

      <p class="menu-hdr">ຈັດການ Product</p>

      <%= link_to dashboard_insurance_companies_path, class: "s-link #{controller_path == 'dashboard/insurance_companies' ? 'active' : ''}" do %>
        <i class="fas fa-shield-alt"></i> ຈັດການປະກັນໄພ
      <% end %>

      <%= link_to dashboard_inspection_centers_path, class: "s-link #{controller_path == 'dashboard/inspection_centers' ? 'active' : ''}" do %>
        <i class="fas fa-tools"></i> ສູນກວດເຕັກນິກ
      <% end %>

      <%= link_to dashboard_service_centers_path + '?type=garage', class: "s-link #{controller_path == 'dashboard/service_centers' && params[:type] == 'garage' ? 'active' : ''}" do %>
        <i class="fas fa-store"></i> ສູນສ້ອມແປງລົດ
      <% end %>

      <%= link_to dashboard_service_centers_path + '?type=towing', class: "s-link #{controller_path == 'dashboard/service_centers' && params[:type] == 'towing' ? 'active' : ''}" do %>
        <i class="fas fa-truck-pickup"></i> ບໍລິການລາກລົດ
      <% end %>

      <%= link_to dashboard_service_centers_path + '?type=dealer', class: "s-link #{controller_path == 'dashboard/service_centers' && params[:type] == 'dealer' ? 'active' : ''}" do %>
        <i class="fas fa-car-side"></i> ສູນຂາຍລົດ
      <% end %>

      <p class="menu-hdr">ລະບົບ</p>

      <%= link_to admin_root_path, class: 's-link' do %>
        <i class="fas fa-cog"></i> ActiveAdmin
      <% end %>

      <%= link_to destroy_admin_user_session_path, method: :delete, class: 's-link', style: 'color:#ef4444;margin-top:8px;' do %>
        <i class="fas fa-sign-out-alt"></i> ອອກຈາກລະບົບ
      <% end %>
    </aside>

    <%# ── Main ── %>
    <main class="mg-main">
      <% if flash[:notice] %><div class="flash-notice"><i class="fas fa-check-circle me-2"></i><%= flash[:notice] %></div><% end %>
      <% if flash[:alert]  %><div class="flash-alert"><i class="fas fa-exclamation-circle me-2"></i><%= flash[:alert] %></div><% end %>
      <%= yield %>
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
