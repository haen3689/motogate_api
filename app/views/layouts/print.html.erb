<!DOCTYPE html>
<html lang="lo">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AutoPass Verification Report</title>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Lao:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0; padding: 32px 28px; background: #F4F8F7; color: #1A1A1A;
      font-family: "Noto Sans Lao", "Courier New", monospace;
    }
    .sheet { max-width: 720px; margin: 0 auto; background: #fff; padding: 28px 32px; box-shadow: 0 4px 20px rgba(0,0,0,.08); }
    table { border-collapse: collapse; width: 100%; }
    @media print {
      body { background: #fff; padding: 0; }
      .sheet { box-shadow: none; padding: 0; max-width: none; }
      .no-print { display: none !important; }
      @page { margin: 14mm; }
    }
    /* On a narrow phone screen (before printing), stack the letterhead
       and the two-column body instead of squeezing them side-by-side —
       this is what caused the sideways overflow. Print/desktop keep the
       original two-column layout since there's room for it there. */
    @media screen and (max-width: 640px) {
      body { padding: 14px 10px; }
      .sheet { padding: 14px; }
      .letterhead-table, .letterhead-table > tbody, .letterhead-table > tbody > tr {
        display: block !important; width: 100% !important;
      }
      .letterhead-table td {
        display: block !important; width: 100% !important; text-align: left !important; padding: 0 0 6px !important;
      }
      .two-col-table, .two-col-table > tbody, .two-col-table > tbody > tr {
        display: block !important; width: 100% !important;
      }
      .two-col-table > tbody > tr > td.col-specs,
      .two-col-table > tbody > tr > td.col-status {
        display: block !important; width: 100% !important; padding: 0 0 16px !important; border: none !important;
      }
    }
  </style>
</head>
<body>
  <div class="sheet"><%= yield %></div>
</body>
</html>
