<!DOCTYPE html>
<html lang="lo">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ຢັ້ງຢືນເອກະສານ · MotoGate</title>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Lao:wght@400;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root { --primary: #0F9B8E; --primary-dark: #0A7366; --ink: #1A1A1A; --muted: #8C8C8C; --bg: #F4F8F7; }
    * { box-sizing: border-box; }
    body {
      margin: 0; min-height: 100vh; background: var(--bg); color: var(--ink);
      font-family: "Noto Sans Lao", system-ui, sans-serif;
      display: flex; align-items: center; justify-content: center; padding: 24px;
    }
    .wrap { width: 100%; max-width: 420px; }
  </style>
</head>
<body>
  <div class="wrap"><%= yield %></div>
</body>
</html>
