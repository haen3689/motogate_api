#!/bin/bash -e

# Prepare primary + Solid Cache/Queue databases (creates + migrates each).
# db/{cache,queue}_migrate now hold real migrations (added because the
# original setup only shipped a schema dump, which db:prepare can't load —
# it only runs pending migrations), so this is enough; no separate
# db:migrate:<name>/db:schema:load:<name> calls needed.
./bin/rails db:prepare || true

exec "${@}"
