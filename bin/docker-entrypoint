#!/bin/bash -e

# Prepare primary database (creates + migrates)
./bin/rails db:prepare || true

# Prepare secondary databases (Solid Cache, Solid Queue, Action Cable).
# These have no migrations dir, only a schema dump (db/*_schema.rb), so
# db:migrate:* is a no-op here — db:prepare:* is what actually creates
# the db and loads that schema.
./bin/rails db:prepare:cache || true
./bin/rails db:prepare:queue || true
./bin/rails db:prepare:cable || true

exec "${@}"
